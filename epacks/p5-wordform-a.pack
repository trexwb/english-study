  { id: 'wf001', base: 'succeed', pos: 'v.', zh: '成功', n: 'success', v: 'succeed', adj: 'successful', adv: 'successfully', exam: '中考', tip: '空格前有冠词或形容词性物主代词就填名词 success，修饰动词用 successfully。' },
  { id: 'wf002', base: 'health', pos: 'n.', zh: '健康', n: 'health', v: '', adj: 'healthy', adv: '', exam: '中考', tip: '系动词 keep 或 stay 后面接形容词 healthy 作表语，表示身体好；名词 health 常作主语或宾语，如 in good health。' },
  { id: 'wf003', base: 'friend', pos: 'n.', zh: '朋友', n: 'friend', v: '', adj: 'friendly', adv: '', exam: '中考', tip: 'be friendly to sb 表示对某人友好，这里 friendly 是形容词作表语，不要误当成副词去修饰动词。' },
  { id: 'wf004', base: 'music', pos: 'n.', zh: '音乐', n: 'music', v: '', adj: 'musical', adv: '', exam: '中考', tip: 'musical instrument 表示乐器，musical 是形容词修饰名词；music 本身是名词，指音乐这门艺术。' },
  { id: 'wf005', base: 'nation', pos: 'n.', zh: '国家', n: 'nation', v: '', adj: 'national', adv: 'nationally', exam: '中考', tip: 'National Day 国庆节中 national 是形容词修饰名词；若要修饰动词或整个句子则用副词 nationally。' },
  { id: 'wf006', base: 'luck', pos: 'n.', zh: '运气', n: 'luck', v: '', adj: 'lucky', adv: 'luckily', exam: '中考', tip: 'good luck 祝好运中 luck 是名词；lucky 是形容词作表语或定语，副词 luckily 常放句首修饰全句。' },
  { id: 'wf007', base: 'pain', pos: 'n.', zh: '疼痛', n: 'pain', v: '', adj: 'painful', adv: 'painfully', exam: '中考', tip: 'a painful memory 一段痛苦的回忆，painful 是形容词修饰名词；pain 是名词，表示疼痛或痛苦本身。' },
  { id: 'wf008', base: 'peace', pos: 'n.', zh: '和平', n: 'peace', v: '', adj: 'peaceful', adv: 'peacefully', exam: '中考', tip: 'a peaceful life 平静的生活，peaceful 是形容词修饰名词；修饰动词表示平静地做某事用副词 peacefully。' },
  { id: 'wf009', base: 'power', pos: 'n.', zh: '力量', n: 'power', v: '', adj: 'powerful', adv: 'powerfully', exam: '中考', tip: 'a powerful country 强大的国家，powerful 是形容词作定语；power 是名词，表示力量、权力或电力。' },
  { id: 'wf010', base: 'noise', pos: 'n.', zh: '噪音', n: 'noise', v: '', adj: 'noisy', adv: 'noisily', exam: '中考', tip: '教室很吵可以说 The classroom is noisy，noisy 是形容词作表语；make a noise 发出响声，noise 是名词。' },
  { id: 'wf011', base: 'hope', pos: 'n.', zh: '希望', n: 'hope', v: '', adj: 'hopeful', adv: 'hopefully', exam: '中考', tip: 'be hopeful about 对某事抱有希望，hopeful 是形容词作表语；副词 hopefully 常放句首修饰整个句子。' },
  { id: 'wf012', base: 'harm', pos: 'v.', zh: '伤害', n: '', v: 'harm', adj: 'harmful', adv: '', exam: '中考', tip: 'be harmful to 对某物有害，harmful 是形容词作表语；harm 作动词时直接接宾语，表示伤害。' },
  { id: 'wf013', base: 'help', pos: 'v.', zh: '帮助', n: '', v: 'help', adj: 'helpful', adv: '', exam: '中考', tip: 'be helpful to 对某人有帮助，helpful 是形容词作表语；help 作动词后可接动词原形或带 to 的不定式。' },
  { id: 'wf014', base: 'grow', pos: 'v.', zh: '生长', n: 'growth', v: 'grow', adj: '', adv: '', exam: '中考', tip: '空前有冠词或 the 就填名词 growth 表示生长；grow 作动词表示生长、种植或渐渐变得。' },
  { id: 'wf015', base: 'happy', pos: 'adj.', zh: '幸福的', n: 'happiness', v: '', adj: 'happy', adv: 'happily', exam: '中考', tip: '修饰动词用副词 happily，拼写时把 y 变 i 再加 ly；名词是 happiness，表示幸福或快乐。' },
  { id: 'wf016', base: 'high', pos: 'adj.', zh: '高的', n: 'height', v: '', adj: 'high', adv: 'highly', exam: '中考', tip: '表示高度用名词 height，注意拼写变化；highly 是副词，常修饰 praise、think 等抽象动词，不表示具体高度。' },
  { id: 'wf017', base: 'honest', pos: 'adj.', zh: '诚实的', n: 'honesty', v: '', adj: 'honest', adv: 'honestly', exam: '中考', tip: 'to be honest 说实话，honest 是形容词；副词 honestly 修饰动词或整个句子，名词是 honesty 诚实。' },
  { id: 'wf018', base: 'important', pos: 'adj.', zh: '重要的', n: 'importance', v: '', adj: 'important', adv: '', exam: '中考', tip: 'of great importance 等于 very important，介词 of 后面必须填名词 importance；作表语或定语时用形容词 important。' },
  { id: 'wf019', base: 'interest', pos: 'n.', zh: '兴趣', n: 'interest', v: '', adj: 'interesting', adv: '', exam: '中考', tip: '修饰物用 interesting 令人有趣的，修饰人的感受用 interested 感兴趣的；show interest in 中 interest 是名词。' },
  { id: 'wf020', base: 'invent', pos: 'v.', zh: '发明', n: 'invention', v: 'invent', adj: '', adv: '', exam: '中考', tip: '空前有冠词或形容词性物主代词就填名词 invention 发明物；invent 作动词表示发明，inventor 是发明者。' },
  { id: 'wf021', base: 'invite', pos: 'v.', zh: '邀请', n: 'invitation', v: 'invite', adj: '', adv: '', exam: '中考', tip: 'receive an invitation 收到一份邀请，invitation 是名词作宾语；invite sb to do sth 邀请某人做某事，invite 是动词。' },
  { id: 'wf022', base: 'kind', pos: 'adj.', zh: '善良的', n: 'kindness', v: '', adj: 'kind', adv: 'kindly', exam: '中考', tip: 'be kind to sb 对某人和善，kind 是形容词作表语；名词 kindness 表示善意、好意，副词 kindly 修饰动词。' },
  { id: 'wf023', base: 'know', pos: 'v.', zh: '知道', n: 'knowledge', v: 'know', adj: '', adv: '', exam: '中考', tip: 'knowledge 是不可数名词，没有复数形式，空前有冠词或形容词就填 knowledge。' },
  { id: 'wf024', base: 'long', pos: 'adj.', zh: '长的', n: 'length', v: '', adj: 'long', adv: '', exam: '中考', tip: '表示长度用名词 length，注意拼写变化；long 本身是形容词，问多长用 How long。' },
  { id: 'wf025', base: 'lose', pos: 'v.', zh: '失去', n: 'loss', v: 'lose', adj: 'lost', adv: '', exam: '中考', tip: '空前有冠词就填名词 loss，lost 可作形容词表示迷路的或丢失的。' },
  { id: 'wf026', base: 'mean', pos: 'v.', zh: '意思是', n: 'meaning', v: 'mean', adj: 'meaningful', adv: '', exam: '中考', tip: 'the meaning of 某物的意思，meaning 是名词；meaningful 是形容词表示有意义的，mean 作动词表示意思是。' },
  { id: 'wf027', base: 'medicine', pos: 'n.', zh: '药', n: 'medicine', v: '', adj: 'medical', adv: '', exam: '中考', tip: 'medical care 医疗护理，medical 是形容词修饰名词；medicine 是名词，表示药或医学，take medicine 吃药。' },
  { id: 'wf028', base: 'mix', pos: 'v.', zh: '混合', n: 'mixture', v: 'mix', adj: 'mixed', adv: '', exam: '中考', tip: 'a mixture of 一种混合物，mixture 是名词；mixed 可作形容词表示混合的，mix 作动词表示混合、搅拌。' },
  { id: 'wf029', base: 'move', pos: 'v.', zh: '移动', n: 'movement', v: 'move', adj: 'moving', adv: '', exam: '中考', tip: '空前有冠词就填名词 movement 表示运动或活动；moving 作形容词表示令人感动的，move 是动词。' },
  { id: 'wf030', base: 'nature', pos: 'n.', zh: '自然', n: 'nature', v: '', adj: 'natural', adv: 'naturally', exam: '中考', tip: 'natural resources 自然资源，natural 是形容词修饰名词；副词 naturally 表示自然地、天然地，nature 是名词自然。' },
  { id: 'wf031', base: 'necessary', pos: 'adj.', zh: '必要的', n: 'necessity', v: '', adj: 'necessary', adv: 'necessarily', exam: '中考', tip: 'It is necessary to do sth 做某事是必要的，necessary 是形容词作表语；not necessarily 表示未必，necessarily 是副词。' },
  { id: 'wf032', base: 'nervous', pos: 'adj.', zh: '紧张的', n: '', v: '', adj: 'nervous', adv: 'nervously', exam: '中考', tip: '系动词 feel 后接形容词 nervous 作表语，修饰实义动词要用副词 nervously。' },
  { id: 'wf033', base: 'normal', pos: 'adj.', zh: '正常的', n: '', v: '', adj: 'normal', adv: 'normally', exam: '中考', tip: '形容词 normal 常在系动词后作表语，修饰动词或整个句子用副词 normally。' },
  { id: 'wf034', base: 'patient', pos: 'adj.', zh: '耐心的', n: 'patience', v: '', adj: 'patient', adv: 'patiently', exam: '中考', tip: 'be patient with sb 对某人有耐心，patient 是形容词作表语；名词 patience 表示耐心，副词 patiently 修饰动词。' },
  { id: 'wf035', base: 'perfect', pos: 'adj.', zh: '完美的', n: 'perfection', v: '', adj: 'perfect', adv: 'perfectly', exam: '中考', tip: '修饰动词用副词 perfectly 表示完美地；perfect 本身是形容词，作定语或表语，名词是 perfection。' },
  { id: 'wf036', base: 'person', pos: 'n.', zh: '人', n: 'person', v: '', adj: 'personal', adv: 'personally', exam: '中考', tip: 'personal information 个人信息，personal 是形容词修饰名词；personally 是副词，表示就个人而言、亲自。' },
  { id: 'wf037', base: 'please', pos: 'v.', zh: '使高兴', n: 'pleasure', v: 'please', adj: 'pleased', adv: '', exam: '中考', tip: 'be pleased with 对某事满意，pleased 是形容词作表语；with pleasure 乐意效劳，pleasure 是名词作介词宾语。' },
  { id: 'wf038', base: 'polite', pos: 'adj.', zh: '有礼貌的', n: 'politeness', v: '', adj: 'polite', adv: 'politely', exam: '中考', tip: '修饰动词用副词 politely 有礼貌地；be polite to sb 对某人有礼貌，polite 是形容词作表语，名词是 politeness。' },
  { id: 'wf039', base: 'pollute', pos: 'v.', zh: '污染', n: 'pollution', v: 'pollute', adj: '', adv: '', exam: '中考', tip: '空前有冠词或介词就填名词 pollution 污染；pollute 作动词表示污染，如 pollute the river 污染河流。' },
  { id: 'wf040', base: 'popular', pos: 'adj.', zh: '受欢迎的', n: 'popularity', v: '', adj: 'popular', adv: '', exam: '中考', tip: 'be popular with 受某人欢迎，popular 是形容词作表语；名词 popularity 表示受欢迎程度、普及。' },
  { id: 'wf041', base: 'possible', pos: 'adj.', zh: '可能的', n: 'possibility', v: '', adj: 'possible', adv: 'possibly', exam: '中考', tip: 'as soon as possible 尽快，possible 是形容词；修饰动词用副词 possibly 表示可能地，名词是 possibility。' },
  { id: 'wf042', base: 'practice', pos: 'n.', zh: '练习', n: 'practice', v: '', adj: 'practical', adv: '', exam: '中考', tip: '空前有冠词就填名词 practice 练习；practical 是形容词表示实用的、实际的，注意与练习区分。' },
  { id: 'wf043', base: 'prepare', pos: 'v.', zh: '准备', n: 'preparation', v: 'prepare', adj: 'prepared', adv: '', exam: '中考', tip: 'prepare for 为某事做准备，prepare 是动词；be prepared for 对某事有准备，prepared 是形容词作表语。' },
  { id: 'wf044', base: 'pride', pos: 'n.', zh: '自豪', n: 'pride', v: '', adj: 'proud', adv: 'proudly', exam: '中考', tip: 'take pride in 以某事为自豪，pride 是名词作宾语；be proud of 为某事骄傲，proud 是形容词作表语。' },
  { id: 'wf045', base: 'produce', pos: 'v.', zh: '生产', n: 'product', v: 'produce', adj: '', adv: '', exam: '中考', tip: '空前有冠词就填名词 product 产品；produce 作动词表示生产、制造，注意名词重音在前。' },
  { id: 'wf046', base: 'protect', pos: 'v.', zh: '保护', n: 'protection', v: 'protect', adj: '', adv: '', exam: '中考', tip: '空前有冠词就填名词 protection 保护；protect 作动词后接 from 或 against，表示保护某物免受伤害。' },
  { id: 'wf047', base: 'public', pos: 'adj.', zh: '公共的', n: '', v: '', adj: 'public', adv: 'publicly', exam: '中考', tip: 'in public 表示公开地、当众；修饰动词用副词 publicly，注意不要多写一个 l。' },
  { id: 'wf048', base: 'quick', pos: 'adj.', zh: '快的', n: '', v: '', adj: 'quick', adv: 'quickly', exam: '中考', tip: '形容词 quick 修饰名词或作表语，表示快的；修饰动词要变成副词 quickly。' },
  { id: 'wf049', base: 'quiet', pos: 'adj.', zh: '安静的', n: '', v: '', adj: 'quiet', adv: 'quietly', exam: '中考', tip: '系动词 keep 后接形容词 quiet 作表语，修饰实义动词要用副词 quietly。' },
  { id: 'wf050', base: 'rain', pos: 'n.', zh: '雨', n: 'rain', v: '', adj: 'rainy', adv: '', exam: '中考', tip: 'a rainy day 一个下雨天，rainy 是形容词修饰名词；rain 本身是名词表示雨，也可作动词表示下雨。' },
  { id: 'wf051', base: 'real', pos: 'adj.', zh: '真的', n: 'reality', v: 'realize', adj: 'real', adv: 'really', exam: '中考', tip: '修饰形容词或动词用副词 really 真正地；realize 是动词表示意识到，名词是 reality 现实。' },
  { id: 'wf052', base: 'reason', pos: 'n.', zh: '理由', n: 'reason', v: '', adj: 'reasonable', adv: 'reasonably', exam: '中考', tip: 'a reasonable price 合理的价格，reasonable 是形容词修饰名词；reason 本身是名词表示理由、原因。' },
  { id: 'wf053', base: 'relax', pos: 'v.', zh: '放松', n: 'relaxation', v: 'relax', adj: 'relaxed', adv: '', exam: '中考', tip: 'feel relaxed 感到放松，relaxed 是形容词作表语修饰人；relax 作动词表示放松，名词是 relaxation。' },
  { id: 'wf054', base: 'safe', pos: 'adj.', zh: '安全的', n: 'safety', v: '', adj: 'safe', adv: 'safely', exam: '中考', tip: 'keep safe 保持安全，safe 是形容词作表语；名词 safety 表示安全，副词 safely 修饰动词表示安全地。' },
  { id: 'wf055', base: 'science', pos: 'n.', zh: '科学', n: 'science', v: '', adj: 'scientific', adv: '', exam: '中考', tip: 'a scientific method 科学的方法，scientific 是形容词修饰名词；science 本身是名词表示科学。' },
  { id: 'wf056', base: 'serve', pos: 'v.', zh: '服务', n: 'service', v: 'serve', adj: '', adv: '', exam: '中考', tip: '空前有冠词就填名词 service 服务；serve 作动词表示服务、招待或上菜。' },
  { id: 'wf057', base: 'serious', pos: 'adj.', zh: '严肃的', n: '', v: '', adj: 'serious', adv: 'seriously', exam: '中考', tip: '副词 seriously 用来修饰动词，例如 take it seriously 认真对待；形容词 serious 常作表语或定语。' },
  { id: 'wf058', base: 'silent', pos: 'adj.', zh: '沉默的', n: 'silence', v: '', adj: 'silent', adv: 'silently', exam: '中考', tip: 'in silence 沉默地，silence 是名词作介词宾语；keep silent 保持安静，silent 是形容词作表语。' },
  { id: 'wf059', base: 'simple', pos: 'adj.', zh: '简单的', n: '', v: 'simplify', adj: 'simple', adv: 'simply', exam: '中考', tip: '修饰动词用副词 simply，拼写时去 e 加 y；simplify 是动词表示简化，simple 是形容词。' },
  { id: 'wf060', base: 'solve', pos: 'v.', zh: '解决', n: 'solution', v: 'solve', adj: '', adv: '', exam: '中考', tip: '空前有冠词就填名词 solution 解决办法；solve 作动词表示解决，如 solve the problem 解决问题。' },
  { id: 'wf061', base: 'special', pos: 'adj.', zh: '特别的', n: '', v: '', adj: 'special', adv: 'specially', exam: '中考', tip: '形容词 special 用来修饰名词，表示特别的；修饰动词要变成副词 specially。' },
  { id: 'wf062', base: 'strong', pos: 'adj.', zh: '强壮的', n: 'strength', v: 'strengthen', adj: 'strong', adv: 'strongly', exam: '中考', tip: '表示力量用名词 strength，注意拼写变化；strengthen 是动词表示加强、巩固，副词是 strongly。' },
  { id: 'wf063', base: 'sudden', pos: 'adj.', zh: '突然的', n: '', v: '', adj: 'sudden', adv: 'suddenly', exam: '中考', tip: 'all of a sudden 突然，sudden 是形容词；修饰动词或整个句子用副词 suddenly，表示突然地。' },
  { id: 'wf064', base: 'suggest', pos: 'v.', zh: '建议', n: 'suggestion', v: 'suggest', adj: '', adv: '', exam: '中考', tip: '空前有冠词就填名词 suggestion 建议；suggest doing sth 建议做某事，suggest 是动词，后接动名词。' },
  { id: 'wf065', base: 'suit', pos: 'v.', zh: '适合', n: '', v: 'suit', adj: 'suitable', adv: '', exam: '中考', tip: 'be suitable for 适合某物，suitable 是形容词作表语；suit 作动词表示适合，主语通常是物。' },
  { id: 'wf066', base: 'surprise', pos: 'v.', zh: '使惊讶', n: '', v: 'surprise', adj: 'surprised', adv: '', exam: '中考', tip: 'be surprised at 对某事感到惊讶，surprised 是形容词修饰人；surprise 作动词表示使惊讶，surprising 修饰物。' },
  { id: 'wf067', base: 'teach', pos: 'v.', zh: '教', n: 'teacher', v: 'teach', adj: '', adv: '', exam: '中考', tip: '表示人用名词 teacher 教师；teach 作动词后接双宾语，如 teach us English 教我们英语。' },
  { id: 'wf068', base: 'thank', pos: 'v.', zh: '感谢', n: 'thanks', v: 'thank', adj: 'thankful', adv: 'thankfully', exam: '中考', tip: 'thanks to 多亏、由于，thanks 是名词；be thankful for 对某事心存感激，thankful 是形容词作表语。' },
  { id: 'wf069', base: 'thought', pos: 'n.', zh: '想法', n: 'thought', v: '', adj: 'thoughtful', adv: 'thoughtfully', exam: '中考', tip: '形容词 thoughtful 表示体贴的或深思的，修饰名词；副词 thoughtfully 修饰动词，thought 是名词想法。' },
  { id: 'wf070', base: 'true', pos: 'adj.', zh: '真的', n: 'truth', v: '', adj: 'true', adv: 'truly', exam: '中考', tip: '修饰动词用副词 truly，拼写时去 e 加 ly；名词是 truth 表示真相、事实，true 是形容词。' },
  { id: 'wf071', base: 'understand', pos: 'v.', zh: '理解', n: 'understanding', v: 'understand', adj: '', adv: '', exam: '中考', tip: '空前有冠词就填名词 understanding 理解、谅解；understand 作动词表示理解、明白。' },
  { id: 'wf072', base: 'use', pos: 'v.', zh: '使用', n: '', v: 'use', adj: 'useful', adv: '', exam: '中考', tip: 'be useful to 对某物有用，useful 是形容词作表语；use 作动词表示使用，注意 useful 前用 a 不用 an。' },
  { id: 'wf073', base: 'usual', pos: 'adj.', zh: '通常的', n: '', v: '', adj: 'usual', adv: 'usually', exam: '中考', tip: 'as usual 像往常一样，usual 是形容词；修饰动词或整个句子用副词 usually 表示通常。' },
  { id: 'wf074', base: 'value', pos: 'n.', zh: '价值', n: 'value', v: '', adj: 'valuable', adv: '', exam: '中考', tip: 'be valuable to 对某物有价值，valuable 是形容词作表语；value 本身是名词表示价值、价值观。' },
  { id: 'wf075', base: 'variety', pos: 'n.', zh: '多样性', n: 'variety', v: 'vary', adj: 'various', adv: '', exam: '中考', tip: 'a variety of 各种各样的，variety 是名词；various 是形容词修饰名词，vary 是动词表示变化。' },
  { id: 'wf076', base: 'visit', pos: 'v.', zh: '参观', n: 'visitor', v: 'visit', adj: '', adv: '', exam: '中考', tip: '表示人用名词 visitor 游客、访客；visit 作动词表示参观或拜访，也可作名词表示访问。' },
  { id: 'wf077', base: 'warm', pos: 'adj.', zh: '温暖的', n: 'warmth', v: '', adj: 'warm', adv: 'warmly', exam: '中考', tip: '表示温暖用名词 warmth，注意拼写；修饰动词用副词 warmly 表示热情地，如 welcome warmly 热烈欢迎。' },
  { id: 'wf078', base: 'warn', pos: 'v.', zh: '警告', n: 'warning', v: 'warn', adj: '', adv: '', exam: '中考', tip: '空前有冠词就填名词 warning 警告；warn 作动词表示警告，如 warn sb not to do sth 警告某人别做某事。' },
  { id: 'wf079', base: 'weak', pos: 'adj.', zh: '虚弱的', n: 'weakness', v: 'weaken', adj: 'weak', adv: '', exam: '中考', tip: '表示弱点用名词 weakness，注意拼写；weaken 是动词表示削弱、变弱，weak 是形容词虚弱的。' },
  { id: 'wf080', base: 'weigh', pos: 'v.', zh: '称重', n: 'weight', v: 'weigh', adj: '', adv: '', exam: '中考', tip: '空前有冠词就填名词 weight 重量；weigh 作动词表示称重、重达，注意拼写变化。' },
  { id: 'wf081', base: 'wide', pos: 'adj.', zh: '宽的', n: 'width', v: 'widen', adj: 'wide', adv: 'widely', exam: '中考', tip: '表示宽度用名词 width，注意拼写；widely 是副词表示广泛地，widen 是动词表示加宽。' },
  { id: 'wf082', base: 'win', pos: 'v.', zh: '赢', n: 'winner', v: 'win', adj: '', adv: '', exam: '中考', tip: '表示人用名词 winner 获胜者；win 作动词后接比赛或奖项，注意不能直接接人作宾语。' },
  { id: 'wf083', base: 'wise', pos: 'adj.', zh: '明智的', n: 'wisdom', v: '', adj: 'wise', adv: 'wisely', exam: '中考', tip: '表示智慧用名词 wisdom，注意拼写变化；修饰动词用副词 wisely 表示明智地，wise 是形容词。' },
  { id: 'wf084', base: 'wonder', pos: 'v.', zh: '想知道', n: '', v: 'wonder', adj: 'wonderful', adv: 'wonderfully', exam: '中考', tip: 'a wonderful time 一段美好的时光，wonderful 是形容词修饰名词；wonder 作动词表示想知道、纳闷。' },
  { id: 'wf085', base: 'work', pos: 'v.', zh: '工作', n: 'worker', v: 'work', adj: '', adv: '', exam: '中考', tip: '表示人用名词 worker 工人；work 作动词表示工作，也可作名词表示工作、作品。' },
  { id: 'wf086', base: 'worry', pos: 'v.', zh: '担心', n: '', v: 'worry', adj: 'worried', adv: '', exam: '中考', tip: 'be worried about 为某事担心，worried 是形容词作表语修饰人；worry 作动词表示担心、发愁。' },
  { id: 'wf087', base: 'write', pos: 'v.', zh: '写', n: 'writer', v: 'write', adj: '', adv: '', exam: '中考', tip: '表示人用名词 writer 作家、作者；write 作动词表示写，过去式是 wrote，过去分词是 written。' },
  { id: 'wf088', base: 'young', pos: 'adj.', zh: '年轻的', n: 'youth', v: '', adj: 'young', adv: '', exam: '中考', tip: '表示青春或年轻人用名词 youth；young 本身是形容词，表示年轻的，作定语或表语。' },
  { id: 'wf089', base: 'prevent', pos: 'v.', zh: '阻止', n: 'prevention', v: 'prevent', adj: '', adv: '', exam: '高考', tip: '空前有冠词或介词填名词 prevention 预防；prevent sb from doing sth 阻止某人做某事，prevent 是动词。' },
  { id: 'wf090', base: 'pure', pos: 'adj.', zh: '纯的', n: 'purity', v: 'purify', adj: 'pure', adv: 'purely', exam: '高考', tip: '语法填空空前有冠词填名词 purity 纯净；作谓语填动词 purify 净化，pure 是形容词。' },
  { id: 'wf091', base: 'receive', pos: 'v.', zh: '收到', n: 'reception', v: 'receive', adj: '', adv: '', exam: '高考', tip: '空前有冠词填名词 reception 接待、接收；receive 作动词表示收到，注意拼写是 ei 不是 ie。' },
  { id: 'wf092', base: 'recognize', pos: 'v.', zh: '认出', n: 'recognition', v: 'recognize', adj: '', adv: '', exam: '高考', tip: '空前有冠词填名词 recognition 认出、认可；recognize 作动词表示认出或认可，注意拼写。' },
  { id: 'wf093', base: 'recommend', pos: 'v.', zh: '推荐', n: 'recommendation', v: 'recommend', adj: '', adv: '', exam: '高考', tip: '语法填空空前有冠词填名词 recommendation 推荐、建议；recommend doing sth 建议做某事，recommend 是动词。' },
  { id: 'wf094', base: 'reduce', pos: 'v.', zh: '减少', n: 'reduction', v: 'reduce', adj: '', adv: '', exam: '高考', tip: '空前有冠词填名词 reduction 减少、降低；reduce 作动词表示减少，如 reduce pollution 减少污染。' },
  { id: 'wf095', base: 'responsible', pos: 'adj.', zh: '负责的', n: 'responsibility', v: '', adj: 'responsible', adv: 'responsibly', exam: '高考', tip: 'be responsible for 对某事负责，responsible 是形容词作表语；take responsibility 承担责任，responsibility 是名词作宾语。' },
  { id: 'wf096', base: 'satisfy', pos: 'v.', zh: '使满意', n: 'satisfaction', v: 'satisfy', adj: 'satisfied', adv: '', exam: '高考', tip: 'with satisfaction 满意地，satisfaction 是名词作介词宾语；be satisfied with 对某事感到满意，satisfied 是形容词。' },
  { id: 'wf097', base: 'select', pos: 'v.', zh: '挑选', n: 'selection', v: 'select', adj: '', adv: '', exam: '高考', tip: '空前有冠词填名词 selection 挑选、选择；select 作动词表示挑选，强调精心选择。' },
  { id: 'wf098', base: 'separate', pos: 'v.', zh: '分开', n: 'separation', v: 'separate', adj: '', adv: 'separately', exam: '高考', tip: '修饰动词用副词 separately 分别地；空前有冠词填名词 separation 分离，separate 作动词表示分开。' },
  { id: 'wf099', base: 'sincere', pos: 'adj.', zh: '真诚的', n: 'sincerity', v: '', adj: 'sincere', adv: 'sincerely', exam: '高考', tip: '修饰动词用副词 sincerely 真诚地；名词 sincerity 表示真诚、诚恳，sincere 是形容词作定语或表语。' },
  { id: 'wf100', base: 'violence', pos: 'n.', zh: '暴力', n: 'violence', v: '', adj: 'violent', adv: 'violently', exam: '高考', tip: 'a violent storm 一场猛烈的暴风雨，violent 是形容词修饰名词；修饰动词用副词 violently 表示猛烈地。' },

  { id: 'wf201', base: 'fail', pos: 'v.', zh: '失败；不及格', n: 'failure', v: 'fail', adj: '', adv: '', exam: '中考', tip: '空前有冠词或介词就填名词 failure，如 end in failure；写作里 Failure is the mother of success 是万能句，此处 failure 不可数；作谓语用 fail，fail to do 表没能做成。' },
  { id: 'wf202', base: 'famous', pos: 'adj.', zh: '著名的', n: 'fame', v: '', adj: 'famous', adv: '', exam: '中考', tip: 'be famous for 表因某事物出名，be famous as 表作为某身份出名；介词后也可填名词 fame，如 win fame。' },
  { id: 'wf203', base: 'fool', pos: 'n.', zh: '傻瓜；愚弄', n: 'fool', v: 'fool', adj: 'foolish', adv: '', exam: '中考', tip: 'fool 名动同形：作主语宾语用 fool，作谓语表愚弄也用 fool；修饰名词或作表语用 foolish，如 a foolish decision。' },
  { id: 'wf204', base: 'free', pos: 'adj.', zh: '空闲的；自由的', n: 'freedom', v: 'free', adj: 'free', adv: 'freely', exam: '中考', tip: 'be 动词后或修饰名词保持 free，如 free time；be free to do 表自由去做；冠词后填名词 freedom；修饰动词用 freely。' },
  { id: 'wf205', base: 'fun', pos: 'n.', zh: '乐趣；有趣', n: 'fun', v: '', adj: 'funny', adv: '', exam: '中考', tip: 'have fun doing 表开心地做某事，fun 前不加冠词；修饰名词表滑稽可笑的用 funny，如 a funny story。' },
  { id: 'wf206', base: 'global', pos: 'adj.', zh: '全球的', n: 'globe', v: '', adj: 'global', adv: 'globally', exam: '高考', tip: '修饰名词用 global，global warming 是环保写作高频话题；修饰动词或整句用 globally；冠词后填名词 globe 表地球。' },
  { id: 'wf207', base: 'govern', pos: 'v.', zh: '统治；管理', n: 'government', v: 'govern', adj: '', adv: '', exam: '高考', tip: '作谓语用 govern，注意时态；冠词后填名词 government，The government has taken measures to... 是写作常用开头。' },
  { id: 'wf208', base: 'hard', pos: 'adj.', zh: '困难的；硬的', n: '', v: '', adj: 'hard', adv: 'hardly', exam: '中考', tip: '修饰名词或 be 动词后用 hard；hardly 表几乎不，如 I could hardly believe it，是常考的半否定词，别和 hard 混淆。' },
  { id: 'wf209', base: 'ill', pos: 'adj.', zh: '有病的', n: 'illness', v: '', adj: 'ill', adv: '', exam: '中考', tip: 'be 动词后用 ill 作表语，fall ill 表生病；冠词或介词后填名词 illness，如 a serious illness。' },
  { id: 'wf210', base: 'inform', pos: 'v.', zh: '告知；通知', n: 'information', v: 'inform', adj: '', adv: '', exam: '中考', tip: '冠词后填名词 information，不可数没有复数；作谓语用 inform sb of sth；keep sb informed 表让某人随时了解情况，常考过去分词。' },
  { id: 'wf211', base: 'injure', pos: 'v.', zh: '使受伤', n: 'injury', v: 'injure', adj: 'injured', adv: '', exam: '中考', tip: '修饰人表受伤的用 injured，the injured 表伤员；冠词后填名词 injury，复数变 injuries；作谓语用 injure，常用被动 be badly injured。' },
  { id: 'wf212', base: 'live', pos: 'v.', zh: '居住；生活', n: 'life', v: 'live', adj: 'lively', adv: '', exam: '中考', tip: '作谓语用 live，live a happy life 是写作好句；冠词后填名词 life；修饰名词表活泼的用 lively，如 a lively girl；alive 只作表语。' },
  { id: 'wf213', base: 'love', pos: 'n.', zh: '爱；热爱', n: 'love', v: 'love', adj: 'lovely', adv: '', exam: '中考', tip: 'love 名动同形：作主语宾语用 love，作谓语也用 love；修饰名词表可爱的用 lovely，如 a lovely day，写作常用。' },
  { id: 'wf214', base: 'marry', pos: 'v.', zh: '结婚', n: 'marriage', v: 'marry', adj: 'married', adv: '', exam: '中考', tip: '表状态用 be married，get married 表动作；marry 后直接接人，不加 with；冠词或介词后填名词 marriage。' },
  { id: 'wf215', base: 'occur', pos: 'v.', zh: '发生；出现', n: 'occurrence', v: 'occur', adj: '', adv: '', exam: '高考', tip: '作谓语用 occur，过去式 occurred 双写 r；It occurred to sb that 表某人突然想到；名词 occurrence 同样双写 r 加 -ence。' },
  { id: 'wf216', base: 'open', pos: 'adj.', zh: '开着的；营业的', n: 'opening', v: 'open', adj: 'open', adv: '', exam: '中考', tip: 'be 动词后用 open 表开着的，keep the door open 常考；作谓语表打开也用 open；冠词后填名词 opening，如 the opening ceremony。' },
  { id: 'wf217', base: 'organize', pos: 'v.', zh: '组织', n: 'organization', v: 'organize', adj: 'organized', adv: '', exam: '中考', tip: '作谓语用 organize，注意 z 的拼写；冠词或介词后填名词 organization；well organized 表有条理，可写进活动总结。' },
  { id: 'wf218', base: 'own', pos: 'adj.', zh: '自己的', n: 'owner', v: 'own', adj: 'own', adv: '', exam: '中考', tip: 'own 前必须加物主代词，如 my own room，on one's own 表独自；作谓语表拥有用 own；指主人用 owner。' },
  { id: 'wf219', base: 'perform', pos: 'v.', zh: '表演', n: 'performance', v: 'perform', adj: '', adv: '', exam: '中考', tip: '作谓语用 perform；冠词后填名词 performance，give a performance 是固定说法；指表演者用 performer。' },
  { id: 'wf220', base: 'poor', pos: 'adj.', zh: '贫穷的；可怜的', n: 'poverty', v: '', adj: 'poor', adv: '', exam: '高考', tip: 'be 动词后或修饰名词用 poor；介词后填名词 poverty，live in poverty 描述社会话题时高考阅读常见。' },
  { id: 'wf221', base: 'prefer', pos: 'v.', zh: '更喜欢', n: 'preference', v: 'prefer', adj: '', adv: '', exam: '高考', tip: '作谓语用 prefer，prefer doing to doing 和 prefer to do rather than do 都常考，过去式 preferred 双写 r；have a preference for 表偏爱。' },
  { id: 'wf222', base: 'pronounce', pos: 'v.', zh: '发音', n: 'pronunciation', v: 'pronounce', adj: '', adv: '', exam: '中考', tip: '作谓语用 pronounce；名词 pronunciation 拼写里没有中间的 o，是高频易错点，How do you pronounce it 常见于课堂与听力。' },
  { id: 'wf223', base: 'prove', pos: 'v.', zh: '证明', n: 'proof', v: 'prove', adj: '', adv: '', exam: '中考', tip: '作谓语用 prove，prove to be 表结果是；介词后填名词 proof，如 proof of the theory；prove oneself 表证明自己的能力。' },
  { id: 'wf224', base: 'recycle', pos: 'v.', zh: '回收利用', n: 'recycling', v: 'recycle', adj: '', adv: '', exam: '中考', tip: '作谓语用 recycle，常用被动 be recycled；介词后填名词 recycling，如 recycling bins，环保话题写作必背。' },
  { id: 'wf225', base: 'relate', pos: 'v.', zh: '与…有关', n: 'relation', v: 'relate', adj: 'related', adv: '', exam: '中考', tip: '作谓语用 relate，常用被动 be related to 表与…有关；修饰名词用 related；Try to relate what you learn to real life 是写作加分句。' },
  { id: 'wf226', base: 'refer', pos: 'v.', zh: '提到；查阅', n: 'reference', v: 'refer', adj: '', adv: '', exam: '高考', tip: '作谓语用 refer to，过去式 referred 双写 r；refer to a dictionary 表查阅词典；冠词后填名词 reference，refer to sb as 表把某人称作。' },
  { id: 'wf227', base: 'reflect', pos: 'v.', zh: '反射；反映', n: 'reflection', v: 'reflect', adj: '', adv: '', exam: '高考', tip: '作谓语用 reflect，reflect on 表反思；冠词后填名词 reflection，读后续写里 in the reflection of the lake 这类描写句很加分。' },
  { id: 'wf228', base: 'require', pos: 'v.', zh: '需要；要求', n: 'requirement', v: 'require', adj: '', adv: '', exam: '中考', tip: '作谓语用 require，The work requires doing 表主动形式含被动；be required to do 表被要求做；meet the requirements 表达到要求，写作常用。' },
  { id: 'wf229', base: 'short', pos: 'adj.', zh: '短的；缺乏的', n: 'shortage', v: '', adj: 'short', adv: '', exam: '高考', tip: 'be short of 表缺乏，修饰名词保持 short，如 a short supply；介词后填名词 shortage，a shortage of water 在环保写作里常用。' },
  { id: 'wf230', base: 'thirsty', pos: 'adj.', zh: '渴的；干旱的', n: 'thirst', v: '', adj: 'thirsty', adv: '', exam: '中考', tip: 'be 动词后用 thirsty，feel thirsty 表口渴；修饰土地表干旱的也用 thirsty，注意 y 变 i 的拼写；名词 thirst 表口渴。' },

  { w: 'routine', p: '/ruːˈtiːn/', pos: 'n.', zh: '作息时间；常规', deck: 'junior', ex: 'My daily routine changes completely during the summer holiday.', exZh: '暑假期间，我的日常作息完全变了。' },
  { w: 'awake', p: '/əˈweɪk/', pos: 'adj.', zh: '醒着的；觉醒的', deck: 'junior', ex: 'I stayed awake until midnight finishing my science project.', exZh: '我一直醒到半夜，把科学项目做完了。' },
  { w: 'asleep', p: '/əˈsliːp/', pos: 'adj.', zh: '睡着的', deck: 'junior', ex: 'The baby fell asleep as soon as the car started.', exZh: '车子一发动，宝宝就睡着了。' },
  { w: 'energetic', p: '/ˌenəˈdʒetɪk/', pos: 'adj.', zh: '精力充沛的', deck: 'junior', ex: 'Morning exercise makes me feel energetic for the whole day.', exZh: '早上锻炼让我一整天都精力充沛。' },
  { w: 'exercise', p: '/ˈeksəsaɪz/', pos: 'n. / v.', zh: '锻炼；运动；练习', deck: 'junior', ex: 'Too much sugar and little exercise are bad for teenagers.', exZh: '糖分摄入过多、运动太少，对青少年很不好。' },
  { w: 'healthy', p: '/ˈhelθi/', pos: 'adj.', zh: '健康的；有益健康的', deck: 'junior', ex: 'Eating vegetables every day helps us stay healthy and strong.', exZh: '每天吃蔬菜有助于我们保持健康强壮。' },
  { w: 'illness', p: '/ˈɪlnəs/', pos: 'n.', zh: '疾病；生病', deck: 'junior', ex: 'A sudden illness kept him away from school last week.', exZh: '上周他突然生病，没能去上学。' },
  { w: 'medicine', p: '/ˈmedsn/', pos: 'n.', zh: '药；医学', deck: 'junior', ex: 'You should take this medicine twice a day after meals.', exZh: '这药应当饭后服用，每天两次。' },
  { w: 'dentist', p: '/ˈdentɪst/', pos: 'n.', zh: '牙医', deck: 'junior', ex: 'My dentist told me to brush my teeth twice daily.', exZh: '牙医嘱咐我每天刷两次牙。' },
  { w: 'headache', p: '/ˈhedeɪk/', pos: 'n.', zh: '头痛', deck: 'junior', ex: 'Staring at a screen for too long gives me a headache.', exZh: '盯着屏幕太久会让我头疼。' },
  { w: 'hurt', p: '/hɜːt/', pos: 'v. / adj.', zh: '使受伤；疼痛的', deck: 'junior', ex: 'He hurt his knee while running in the sports meeting.', exZh: '他在运动会上跑步时伤了膝盖。' },
  { w: 'rest', p: '/rest/', pos: 'n. / v.', zh: '休息；剩余部分', deck: 'junior', ex: 'Taking a short rest helps students focus on their work.', exZh: '短暂休息一下能让学生更专注地学习。' },
  { w: 'relax', p: '/rɪˈlæks/', pos: 'v.', zh: '放松；休息', deck: 'junior', ex: 'Listening to light music helps me relax after a busy day.', exZh: '忙碌一天后，听轻音乐能帮我放松。' },
  { w: 'breakfast', p: '/ˈbrekfəst/', pos: 'n.', zh: '早餐；早饭', deck: 'junior', ex: 'Never skip breakfast, or you will feel tired before lunch.', exZh: '千万别不吃早饭，否则午饭前你就会乏力。' },
  { w: 'vegetable', p: '/ˈvedʒtəbl/', pos: 'n.', zh: '蔬菜', deck: 'junior', ex: 'Fresh vegetables should be part of every single meal.', exZh: '新鲜蔬菜应当是每一餐的一部分。' },
  { w: 'delicious', p: '/dɪˈlɪʃəs/', pos: 'adj.', zh: '美味的；可口的', deck: 'junior', ex: 'The soup my mother cooked last night was really delicious.', exZh: '我妈妈昨晚做的汤真好喝。' },

  { w: 'tidy', p: '/ˈtaɪdi/', pos: 'adj. / v.', zh: '整洁的；整理', deck: 'junior', ex: 'Please tidy your desk before the exam begins.', exZh: '考试前请把书桌整理干净。' },
  { w: 'sweep', p: '/swiːp/', pos: 'v.', zh: '扫；打扫', deck: 'junior', ex: 'We sweep the classroom floor every Friday afternoon.', exZh: '我们每周五下午都打扫教室地面。' },
  { w: 'wash', p: '/wɒʃ/', pos: 'v.', zh: '洗；洗涤', deck: 'junior', ex: 'Remember to wash your hands before you eat anything.', exZh: '记得吃东西前先洗手。' },
  { w: 'cook', p: '/kʊk/', pos: 'v.', zh: '烹饪；煮；做饭', deck: 'junior', ex: 'Last term I learned to cook noodles for my family.', exZh: '上学期我学会了给家人煮面条。' },
  { w: 'water', p: '/ˈwɔːtə/', pos: 'v. / n.', zh: '浇水；水', deck: 'junior', ex: 'Water the plants every two days while she is away.', exZh: '她不在的时候，每隔两天给花浇一次水。' },
  { w: 'allowance', p: '/əˈlaʊəns/', pos: 'n.', zh: '零花钱；津贴；定量', deck: 'junior', ex: 'My parents give me a small allowance every month.', exZh: '父母每月给我一点零花钱。' },
  { w: 'save', p: '/seɪv/', pos: 'v.', zh: '攒钱；节约；拯救', deck: 'junior', ex: 'I save part of my pocket money to buy a bike.', exZh: '我把一部分零花钱攒下来买自行车。' },
  { w: 'spend', p: '/spend/', pos: 'v.', zh: '花费；度过', deck: 'junior', ex: 'Teenagers often spend too much time on their phones.', exZh: '青少年常常在手机上花太多时间。' },
  { w: 'price', p: '/praɪs/', pos: 'n.', zh: '价格；价钱', deck: 'junior', ex: 'The price of this jacket is too high for me.', exZh: '这件夹克的价格对我来说太高了。' },
  { w: 'cheap', p: '/tʃiːp/', pos: 'adj.', zh: '便宜的；廉价的', deck: 'junior', ex: 'This small shop sells cheap but useful school things.', exZh: '这家小店卖的东西便宜又实用。' },
  { w: 'expensive', p: '/ɪkˈspensɪv/', pos: 'adj.', zh: '昂贵的', deck: 'junior', ex: 'A new phone is expensive, so I will wait a year.', exZh: '新手机很贵，所以我打算再等一年。' },
  { w: 'cost', p: '/kɒst/', pos: 'v. / n.', zh: '花费；费用；代价', deck: 'junior', ex: 'Repairing the old bike cost less than buying a new one.', exZh: '修那辆旧自行车比买辆新的花得少。' },
  { w: 'pay', p: '/peɪ/', pos: 'v. / n.', zh: '支付；工资', deck: 'junior', ex: 'My father paid for the tickets and the small hotel.', exZh: '爸爸付了票钱和那间小旅馆的费用。' },
  { w: 'buy', p: '/baɪ/', pos: 'v.', zh: '买；购买', deck: 'junior', ex: 'She bought a birthday gift for her best friend.', exZh: '她给她最好的朋友买了一份生日礼物。' },
  { w: 'sell', p: '/sel/', pos: 'v.', zh: '卖；出售', deck: 'junior', ex: 'Our class will sell old books to raise money for the school.', exZh: '我们班要卖旧书，为学校筹钱。' },
  { w: 'customer', p: '/ˈkʌstəmə/', pos: 'n.', zh: '顾客；客户', deck: 'junior', ex: 'The shop assistant greeted every customer with a warm smile.', exZh: '店员对每位顾客都报以热情的微笑。' },
  { w: 'choose', p: '/tʃuːz/', pos: 'v.', zh: '选择；挑选', deck: 'junior', ex: 'Choose the books you like instead of only the listed ones.', exZh: '挑你喜欢的书，别只按书单来选。' },

  { w: 'subject', p: '/ˈsʌbdʒɪkt/', pos: 'n.', zh: '科目；主题；学科', deck: 'junior', ex: 'Math is my weakest subject, so I often ask the teacher for help.', exZh: '数学是我最弱的科目，所以我常向老师求助。' },
  { w: 'course', p: '/kɔːs/', pos: 'n.', zh: '课程；过程', deck: 'junior', ex: 'Our school offers a new course on traditional Chinese art.', exZh: '学校新开了一门中国传统艺术课。' },
  { w: 'lesson', p: '/ˈlesn/', pos: 'n.', zh: '课；一节课；教训', deck: 'junior', ex: 'Yesterday we had a useful lesson about staying safe online.', exZh: '昨天我们上了一堂有用的网络安全课。' },
  { w: 'grade', p: '/ɡreɪd/', pos: 'n.', zh: '分数；年级；等级', deck: 'junior', ex: 'My English grade improved after I kept a vocabulary notebook.', exZh: '坚持记单词本后，我的英语成绩提高了。' },
  { w: 'classmate', p: '/ˈklɑːsmeɪt/', pos: 'n.', zh: '同学', deck: 'junior', ex: 'A kind classmate lent me her umbrella in the heavy rain.', exZh: '下大雨时，一位热心的同学把伞借给了我。' },
  { w: 'library', p: '/ˈlaɪbrəri/', pos: 'n.', zh: '图书馆；藏书室', deck: 'junior', ex: 'Our school library stays open until six in the evening.', exZh: '我们学校图书馆晚上开到六点。' },
  { w: 'dictionary', p: '/ˈdɪkʃənri/', pos: 'n.', zh: '词典；字典', deck: 'junior', ex: 'Look up new words in a dictionary before you guess their meanings.', exZh: '猜词义之前，先在词典里查一下生词。' },
  { w: 'experiment', p: '/ɪkˈsperɪmənt/', pos: 'n. / v.', zh: '实验；试验', deck: 'junior', ex: 'We did an interesting experiment about plants and light in class.', exZh: '我们在课上做了一个关于植物和光的有趣实验。' },
  { w: 'physics', p: '/ˈfɪzɪks/', pos: 'n.', zh: '物理学', deck: 'junior', ex: 'Physics is hard, but doing experiments makes it more interesting.', exZh: '物理很难，但做实验让它更有趣。' },
  { w: 'chemistry', p: '/ˈkemɪstri/', pos: 'n.', zh: '化学', deck: 'junior', ex: 'In chemistry class we learned to heat liquids safely and slowly.', exZh: '化学课上，我们学会了怎样安全地慢慢加热液体。' },
  { w: 'discussion', p: '/dɪˈskʌʃn/', pos: 'n.', zh: '讨论；商量', deck: 'junior', ex: 'Our discussion about school rules lasted the whole afternoon.', exZh: '我们关于校规的讨论持续了整整一下午。' },
  { w: 'homework', p: '/ˈhəʊmwɜːk/', pos: 'n.', zh: '家庭作业', deck: 'junior', ex: 'I usually finish my homework before dinner and then read a chapter.', exZh: '我通常晚饭前写完作业，然后读一章书。' },
  { w: 'review', p: '/rɪˈvjuː/', pos: 'v. / n.', zh: '复习；回顾；评论', deck: 'junior', ex: 'Review your notes the same day, or you will forget quickly.', exZh: '当天就要复习笔记，不然忘得很快。' },
  { w: 'grammar', p: '/ˈɡræmə/', pos: 'n.', zh: '语法', deck: 'junior', ex: 'Reading short stories is a fun way to learn grammar.', exZh: '读小故事是学语法的有趣方式。' },
  { w: 'pronunciation', p: '/prəˌnʌnsiˈeɪʃn/', pos: 'n.', zh: '发音；发音法', deck: 'junior', ex: 'Practising your pronunciation every morning will build real confidence.', exZh: '每天早上练发音，能真正建立起自信。' },
  { w: 'attend', p: '/əˈtend/', pos: 'v.', zh: '参加；上学；出席', deck: 'junior', ex: 'All students must attend the opening ceremony on Monday morning.', exZh: '全体学生周一上午都必须参加开学典礼。' },
  { w: 'absent', p: '/ˈæbsənt/', pos: 'adj.', zh: '缺席的；不在的', deck: 'junior', ex: 'He was absent from school because he caught a bad cold.', exZh: '他因为重感冒没去上学。' },

  { w: 'exam', p: '/ɪɡˈzæm/', pos: 'n.', zh: '考试', deck: 'junior', ex: 'We have an important English exam at the end of this month.', exZh: '我们这个月末有一场重要的英语考试。' },
  { w: 'score', p: '/skɔː/', pos: 'n. / v.', zh: '分数；得分；评分', deck: 'junior', ex: 'Her writing score was much higher than she expected.', exZh: '她的写作分数比她预想的高得多。' },
  { w: 'practice', p: '/ˈpræktɪs/', pos: 'n. / v.', zh: '练习；实践', deck: 'junior', ex: 'Practice spoken English with your friends after every class.', exZh: '每堂课下课后，都要和同学练习英语口语。' },
  { w: 'effort', p: '/ˈefət/', pos: 'n.', zh: '努力；费力', deck: 'junior', ex: 'If you put in more effort, the result will change.', exZh: '如果你多付出一些努力，结果就会不同。' },
  { w: 'goal', p: '/ɡəʊl/', pos: 'n.', zh: '目标；球门', deck: 'junior', ex: 'Setting a small goal each week keeps me moving forward.', exZh: '每周定一个小目标，能推动我不断向前。' },
  { w: 'manage', p: '/ˈmænɪdʒ/', pos: 'v.', zh: '设法做到；管理', deck: 'junior', ex: 'She managed to finish the long race despite the pain.', exZh: '尽管身上疼，她还是坚持跑完了长跑。' },
  { w: 'fail', p: '/feɪl/', pos: 'v.', zh: '失败；不及格；未能', deck: 'junior', ex: 'Do not be sad if you fail once; just try again.', exZh: '就算一次没考好也别灰心，再试一次。' },
  { w: 'pass', p: '/pɑːs/', pos: 'v.', zh: '通过；传递；经过', deck: 'junior', ex: 'I hope you pass the coming exam with a good result.', exZh: '希望你通过即将到来的考试，取得好成绩。' },
  { w: 'correct', p: '/kəˈrekt/', pos: 'v. / adj.', zh: '改正；正确的', deck: 'junior', ex: 'The teacher asked us to correct our own mistakes carefully.', exZh: '老师让我们自己仔细改正作业里的错误。' },
  { w: 'graduate', p: '/ˈɡrædʒueɪt/', pos: 'v. / n.', zh: '毕业；毕业生', deck: 'junior', ex: 'We will graduate from junior high school next June.', exZh: '明年六月我们就初中毕业了。' },
  { w: 'strict', p: '/strɪkt/', pos: 'adj.', zh: '严格的；严厉的', deck: 'junior', ex: 'Our maths teacher is strict but always fair to everyone.', exZh: '我们的数学老师很严格，但对每个人都公平。' },
  { w: 'praise', p: '/preɪz/', pos: 'v. / n.', zh: '表扬；称赞', deck: 'junior', ex: 'The headmaster praised the two students for their honesty.', exZh: '校长表扬了这两名学生的诚实。' },
  { w: 'remind', p: '/rɪˈmaɪnd/', pos: 'v.', zh: '提醒；使想起', deck: 'junior', ex: 'Please remind me to return the book to the library tomorrow.', exZh: '请提醒我明天把书还回图书馆。' },
  { w: 'explain', p: '/ɪkˈspleɪn/', pos: 'v.', zh: '解释；说明', deck: 'junior', ex: 'I asked the teacher to explain that grammar rule once more.', exZh: '我请老师把那条语法规则再讲一遍。' },
  { w: 'contest', p: '/ˈkɒntest/', pos: 'n.', zh: '比赛；竞赛', deck: 'junior', ex: 'He won first place in the city English speech contest.', exZh: '他在市英语演讲比赛中获得第一名。' },
  { w: 'prize', p: '/praɪz/', pos: 'n.', zh: '奖品；奖金；奖项', deck: 'junior', ex: 'The prize for the winner is a set of science books.', exZh: '给获胜者的奖品是一套科普书。' },
  { w: 'lose', p: '/luːz/', pos: 'v.', zh: '输；失去；丢失', deck: 'junior', ex: 'Even if we lose the match, our team will keep trying.', exZh: '即使这场比赛输了，我们队也会继续努力。' },

  { w: 'club', p: '/klʌb/', pos: 'n.', zh: '社团；俱乐部', deck: 'junior', ex: 'Joining a chess club helped me make some new friends.', exZh: '加入国际象棋社团帮我交到了新朋友。' },
  { w: 'activity', p: '/ækˈtɪvəti/', pos: 'n.', zh: '活动', deck: 'junior', ex: 'Volunteering is a meaningful activity that we can do at weekends.', exZh: '做志愿者是我们周末可以做的有意义活动。' },
  { w: 'event', p: '/ɪˈvent/', pos: 'n.', zh: '活动；事件；大事', deck: 'junior', ex: 'The sports meeting was the biggest event of the whole year.', exZh: '运动会是这一年里最大的活动。' },
  { w: 'performance', p: '/pəˈfɔːməns/', pos: 'n.', zh: '表演；演出；表现', deck: 'junior', ex: 'Their short performance made the whole audience laugh happily.', exZh: '他们的短剧表演让全场观众开怀大笑。' },
  { w: 'concert', p: '/ˈkɒnsət/', pos: 'n.', zh: '音乐会；演唱会', deck: 'junior', ex: 'The school concert will be held in the music hall.', exZh: '学校音乐会将在这个音乐厅举行。' },
  { w: 'match', p: '/mætʃ/', pos: 'n.', zh: '比赛；竞赛；火柴', deck: 'junior', ex: 'We watched the football match until the final whistle.', exZh: '我们观看足球比赛，一直看到终场哨响。' },
  { w: 'speech', p: '/spiːtʃ/', pos: 'n.', zh: '演讲；讲话', deck: 'junior', ex: 'His speech about protecting rivers moved a lot of students.', exZh: '他那篇关于保护河流的演讲打动了很多同学。' },
  { w: 'stage', p: '/steɪdʒ/', pos: 'n.', zh: '舞台；阶段', deck: 'junior', ex: 'She walked onto the stage with her heart beating fast.', exZh: '她心怦怦直跳地走上舞台。' },
  { w: 'festival', p: '/ˈfestɪvl/', pos: 'n.', zh: '节日；节', deck: 'junior', ex: 'During the Spring Festival, families get together and share big meals.', exZh: '春节期间，家人会聚在一起吃团圆饭。' },
  { w: 'lantern', p: '/ˈlæntən/', pos: 'n.', zh: '灯笼', deck: 'junior', ex: 'Children carry beautiful lanterns on the evening of that festival.', exZh: '元宵节晚上，孩子们提着漂亮的灯笼。' },
  { w: 'tradition', p: '/trəˈdɪʃn/', pos: 'n.', zh: '传统；惯例', deck: 'junior', ex: 'Making dumplings at New Year is a cherished family tradition.', exZh: '新年包饺子是我们家珍视的传统。' },
  { w: 'gift', p: '/ɡɪft/', pos: 'n.', zh: '礼物；天赋', deck: 'junior', ex: 'A sincere thank-you is the best gift for a true friend.', exZh: '真诚的感谢是给朋友最好的礼物。' },
  { w: 'decorate', p: '/ˈdekəreɪt/', pos: 'v.', zh: '装饰；布置', deck: 'junior', ex: 'We decorated the classroom with paper flowers for the party.', exZh: '为了开联欢会，我们用纸花布置了教室。' },
  { w: 'gather', p: '/ˈɡæðə/', pos: 'v.', zh: '聚集；收集', deck: 'junior', ex: 'Villagers gather in the square every autumn to celebrate the harvest.', exZh: '每年秋天，村民都会在广场上聚集庆祝丰收。' },

  { w: 'transport', p: '/ˈtrænspɔːt/', pos: 'n.', zh: '交通；运输；交通工具', deck: 'junior', ex: 'Public transport in our city is cheap and very convenient.', exZh: '我们城市的公共交通既便宜又方便。' },
  { w: 'passenger', p: '/ˈpæsɪndʒə/', pos: 'n.', zh: '乘客；旅客', deck: 'junior', ex: 'The bus driver waited for the last passenger to sit down.', exZh: '公交司机等到最后一位乘客坐好才开车。' },
  { w: 'ticket', p: '/ˈtɪkɪt/', pos: 'n.', zh: '票；入场券', deck: 'junior', ex: 'I booked a train ticket online before the holiday began.', exZh: '假期一开始前，我就在网上订好了火车票。' },
  { w: 'station', p: '/ˈsteɪʃn/', pos: 'n.', zh: '车站；站；局', deck: 'junior', ex: 'Please meet me at the south entrance of the station.', exZh: '请在车站南出口和我碰头。' },
  { w: 'trip', p: '/trɪp/', pos: 'n.', zh: '旅行；短途行程', deck: 'junior', ex: 'Our school trip to the science museum was truly wonderful.', exZh: '学校组织去科学博物馆的参观活动棒极了。' },
  { w: 'travel', p: '/ˈtrævl/', pos: 'v. / n.', zh: '旅行；行进', deck: 'junior', ex: 'Travelling to new places opens our eyes to the wider world.', exZh: '去新的地方旅行，让我们对更广阔的世界开阔眼界。' },
  { w: 'tour', p: '/tʊə/', pos: 'n. / v.', zh: '游览；参观；巡回旅行', deck: 'junior', ex: 'A guided tour of the old town takes about two hours.', exZh: '跟着导游游览老城大约要两个小时。' },
  { w: 'guide', p: '/ɡaɪd/', pos: 'n. / v.', zh: '导游；指南；引导', deck: 'junior', ex: 'Our guide told us many stories about the ancient bridge.', exZh: '导游给我们讲了许多关于这座古桥的故事。' },
  { w: 'straight', p: '/streɪt/', pos: 'adv. / adj.', zh: '笔直地；直接的', deck: 'junior', ex: 'Walk straight along this road and turn left at the corner.', exZh: '沿这条路一直走，到拐角处向左拐。' },
  { w: 'abroad', p: '/əˈbrɔːd/', pos: 'adv.', zh: '在国外；到国外', deck: 'junior', ex: 'Some students go abroad to study English every single summer.', exZh: '有些学生每年暑假都到国外学英语。' },
  { w: 'sightseeing', p: '/ˈsaɪtsiːɪŋ/', pos: 'n.', zh: '观光；游览', deck: 'junior', ex: 'We spent the whole afternoon sightseeing around the lake by bike.', exZh: '我们整个下午都骑车在湖边观光。' },
  { w: 'countryside', p: '/ˈkʌntrisaɪd/', pos: 'n.', zh: '乡村；农村', deck: 'junior', ex: 'Life in the countryside is much quieter than in the city.', exZh: '乡村生活比城市安静得多。' },
  { w: 'village', p: '/ˈvɪlɪdʒ/', pos: 'n.', zh: '村庄；村民', deck: 'junior', ex: 'Grandmother lives in a small village with only twenty houses.', exZh: '奶奶住在一个只有二十户人家的小村庄里。' },
  { w: 'crowd', p: '/kraʊd/', pos: 'n. / v.', zh: '人群；拥挤', deck: 'junior', ex: 'A large crowd waited quietly outside the concert hall.', exZh: '一大群人在音乐厅外安静地等着。' },
  { w: 'convenient', p: '/kənˈviːniənt/', pos: 'adj.', zh: '方便的；便利的', deck: 'junior', ex: 'Living near a subway station is very convenient for students.', exZh: '住在地铁站附近对学生来说很方便。' },

  { w: 'rule', p: '/ruːl/', pos: 'n. / v.', zh: '规则；规定；统治', deck: 'junior', ex: 'Every student must follow the school rules and keep quiet.', exZh: '每个学生都必须遵守校规，保持安静。' },
  { w: 'obey', p: '/əˈbeɪ/', pos: 'v.', zh: '遵守；服从', deck: 'junior', ex: 'We must obey traffic rules even when nobody is watching.', exZh: '即使没人看见，我们也要遵守交通规则。' },
  { w: 'sign', p: '/saɪn/', pos: 'n. / v.', zh: '标志；手势；签名', deck: 'junior', ex: 'A sign near the pool warns that swimming alone is dangerous.', exZh: '泳池边的标志牌提醒单独游泳很危险。' },
  { w: 'limit', p: '/ˈlɪmɪt/', pos: 'n. / v.', zh: '限度；限制', deck: 'junior', ex: 'Parents should set a clear limit on daily screen time.', exZh: '家长应当明确规定每天使用屏幕的时长。' },
  { w: 'fine', p: '/faɪn/', pos: 'n. / adj.', zh: '罚款；好的', deck: 'junior', ex: 'You may get a fine for riding without a helmet.', exZh: '骑车不戴头盔可能会被罚款。' },
  { w: 'queue', p: '/kjuː/', pos: 'n. / v.', zh: '队伍；排队', deck: 'junior', ex: 'Please queue for the bus instead of pushing to the front.', exZh: '请排队上车，别挤到最前面。' },
  { w: 'public', p: '/ˈpʌblɪk/', pos: 'adj. / n.', zh: '公共的；公众', deck: 'junior', ex: 'We should keep public places clean, quiet and easy to use.', exZh: '我们应当让公共场所保持干净、安静、好用。' },
  { w: 'manners', p: '/ˈmænəz/', pos: 'n.', zh: '礼貌；举止', deck: 'junior', ex: 'Good manners include saying please and thank you quite often.', exZh: '良好的举止包括经常把请和谢谢挂在嘴边。' },
  { w: 'behave', p: '/bɪˈheɪv/', pos: 'v.', zh: '表现；举止；举止端正', deck: 'junior', ex: 'The younger children behaved well during the long museum visit.', exZh: '参观博物馆的那段长时间里，几个小同学表现得很好。' },
  { w: 'greet', p: '/ɡriːt/', pos: 'v.', zh: '问候；迎接；欢迎', deck: 'junior', ex: 'In some countries, people bow to greet each other politely.', exZh: '在一些国家，人们鞠躬相互礼貌致意。' },
  { w: 'wave', p: '/weɪv/', pos: 'v. / n.', zh: '挥手；波浪', deck: 'junior', ex: 'She waved goodbye to us from the slowly moving train.', exZh: '她从缓缓启动的火车上挥手和我们告别。' },
  { w: 'charity', p: '/ˈtʃærəti/', pos: 'n.', zh: '慈善；慈善机构', deck: 'junior', ex: 'Our class gave all the money to a charity for young children.', exZh: '我们班把全部钱都捐给了一家儿童慈善机构。' },
  { w: 'donate', p: '/dəʊˈneɪt/', pos: 'v.', zh: '捐赠；捐献', deck: 'junior', ex: 'Students donated hundreds of books to schools in mountain areas.', exZh: '学生们给山区学校捐了几百本书。' },
  { w: 'generous', p: '/ˈdʒenərəs/', pos: 'adj.', zh: '慷慨的；大方的', deck: 'junior', ex: 'A generous man helped two poor students without asking anything.', exZh: '一位慷慨的人帮助了两名贫困学生，不求任何回报。' },

  { w: 'weather', p: '/ˈweðə/', pos: 'n.', zh: '天气；气象', deck: 'junior', ex: 'The weather suddenly turned cold, so I put on a warm coat.', exZh: '天气突然变冷，我加了一件暖和的外套。' },
  { w: 'wind', p: '/wɪnd/', pos: 'n.', zh: '风；气流', deck: 'junior', ex: 'A strong wind blew the yellow leaves across the playground.', exZh: '一阵大风把黄叶吹过了整个操场。' },
  { w: 'cloud', p: '/klaʊd/', pos: 'n.', zh: '云；云朵', deck: 'junior', ex: 'Dark clouds gathered low, and it soon began to rain heavily.', exZh: '乌云压得很低，很快就开始下大雨。' },
  { w: 'fog', p: '/fɒɡ/', pos: 'n.', zh: '雾；迷雾', deck: 'junior', ex: 'Thick fog made every driver slow down near the long bridge.', exZh: '大雾让司机在长桥附近都放慢了车速。' },
  { w: 'storm', p: '/stɔːm/', pos: 'n.', zh: '暴风雨；风暴', deck: 'junior', ex: 'The heavy storm stopped us from playing basketball outside.', exZh: '那场大暴雨让我们在室外打不了篮球。' },
  { w: 'lightning', p: '/ˈlaɪtnɪŋ/', pos: 'n.', zh: '闪电', deck: 'junior', ex: 'Bright lightning lit up the sky just before the rain came.', exZh: '就在下雨之前，明亮的闪电照亮了天空。' },
  { w: 'flood', p: '/flʌd/', pos: 'n. / v.', zh: '洪水；水灾；淹没', deck: 'junior', ex: 'After the flood, volunteers helped those farmers clean their fields.', exZh: '洪水过后，志愿者们帮这些农民清理了田地。' },
  { w: 'rainstorm', p: '/ˈreɪnstɔːm/', pos: 'n.', zh: '暴雨；暴风雨', deck: 'junior', ex: 'A sudden rainstorm caught us on the way back home.', exZh: '在回家的路上，我们突然遇到一场暴雨。' },
  { w: 'typhoon', p: '/taɪˈfuːn/', pos: 'n.', zh: '台风', deck: 'junior', ex: 'School closed early because a powerful typhoon was coming.', exZh: '因为强台风将至，学校提前放学了。' },
  { w: 'temperature', p: '/ˈtemprətʃə/', pos: 'n.', zh: '温度；气温；体温', deck: 'junior', ex: 'The temperature dropped below zero, and the lake slowly froze.', exZh: '气温降到零度以下，湖面慢慢结了冰。' },
  { w: 'season', p: '/ˈsiːzn/', pos: 'n.', zh: '季节；赛季', deck: 'junior', ex: 'Autumn is my favourite season because the hills turn gold.', exZh: '秋天是我最喜欢的季节，因为山都变成了金色。' },
  { w: 'earthquake', p: '/ˈɜːθkweɪk/', pos: 'n.', zh: '地震', deck: 'junior', ex: 'The earthquake broke many roads, so soldiers flew in the food.', exZh: '地震震断了许多公路，士兵们只好空运食物。' },
  { w: 'sky', p: '/skaɪ/', pos: 'n.', zh: '天空；天', deck: 'junior', ex: 'On clear nights the sky is full of tiny shining stars.', exZh: '晴朗的夜晚，天空布满闪闪的小星星。' },
  { w: 'warm', p: '/wɔːm/', pos: 'adj. / v.', zh: '温暖的；使暖和', deck: 'junior', ex: 'Warm spring breezes gently wake the flowers in the garden.', exZh: '温暖的春风轻轻吹醒了园子里的花。' },
  { w: 'cool', p: '/kuːl/', pos: 'adj. / v.', zh: '凉爽的；使冷却', deck: 'junior', ex: 'A cool wind came up as the sun went down behind the hills.', exZh: '太阳落到山后时，起了一阵凉风。' },
  { w: 'dry', p: '/draɪ/', pos: 'adj. / v.', zh: '干燥的；干的；弄干', deck: 'junior', ex: 'The weather has been dry for weeks, so young trees need water.', exZh: '天气已经干了好几个星期，小树需要浇水。' },

  { w: 'wildlife', p: '/ˈwaɪldlaɪf/', pos: 'n.', zh: '野生动物；野生生物', deck: 'junior', ex: 'Protecting wildlife helps keep the whole natural world in balance.', exZh: '保护野生动物有助于维持整个自然界的平衡。' },
  { w: 'plant', p: '/plɑːnt/', pos: 'n. / v.', zh: '植物；种植；工厂', deck: 'junior', ex: 'We planted young trees on the hill with our teachers.', exZh: '我们和老师一起在山上种下了小树苗。' },
  { w: 'monkey', p: '/ˈmʌŋki/', pos: 'n.', zh: '猴子', deck: 'junior', ex: 'Little monkeys followed the visitors and quietly asked for food.', exZh: '小猴子跟着游客，安安静静地讨东西吃。' },
  { w: 'butterfly', p: '/ˈbʌtfəlaɪ/', pos: 'n.', zh: '蝴蝶', deck: 'junior', ex: 'A colourful butterfly landed on the white flower without a sound.', exZh: '一只彩色的蝴蝶无声地落在白花上。' },
  { w: 'bamboo', p: '/bæmˈbuː/', pos: 'n.', zh: '竹子；竹林', deck: 'junior', ex: 'Pandas spend most of every day eating fresh green bamboo.', exZh: '熊猫一天大部分时间都在吃新鲜的青竹。' },
  { w: 'mammal', p: '/ˈmæml/', pos: 'n.', zh: '哺乳动物', deck: 'junior', ex: 'The blue whale is the largest mammal living on our planet.', exZh: '蓝鲸是地球上最大的哺乳动物。' },
  { w: 'soil', p: '/sɔɪl/', pos: 'n.', zh: '土壤；土地', deck: 'junior', ex: 'Fallen leaves turn into rich soil and then feed new plants.', exZh: '落叶变成肥沃的土壤，反过来又滋养新的植物。' },
  { w: 'pollution', p: '/pəˈluːʃn/', pos: 'n.', zh: '污染；污染物', deck: 'junior', ex: 'Air pollution in big cities harms young children and old people.', exZh: '大城市的空气污染危害幼儿和老人。' },
  { w: 'rubbish', p: '/ˈrʌbɪʃ/', pos: 'n.', zh: '垃圾；废物', deck: 'junior', ex: 'Sort the rubbish into different bins before you throw it away.', exZh: '扔垃圾之前，先把它分类放进不同的桶。' },
  { w: 'waste', p: '/weɪst/', pos: 'v. / n.', zh: '浪费；废物；垃圾', deck: 'junior', ex: 'Do not waste water while you are brushing your teeth.', exZh: '刷牙的时候不要浪费水。' },
  { w: 'plastic', p: '/ˈplæstɪk/', pos: 'n. / adj.', zh: '塑料；塑料的', deck: 'junior', ex: 'Using fewer plastic bags helps keep the sea around us clean.', exZh: '少用塑料袋有助于保持我们周围的海洋清洁。' },
  { w: 'reduce', p: '/rɪˈdjuːs/', pos: 'v.', zh: '减少；降低', deck: 'junior', ex: 'Riding a bike to school can reduce the pollution in the city.', exZh: '骑车上学能减少城市里的污染。' },
  { w: 'reuse', p: '/ˌriːˈjuːz/', pos: 'v.', zh: '重复使用；再利用', deck: 'junior', ex: 'In class we reuse old bottles as small vases for flowers.', exZh: '我们在课上把旧瓶子再利用，当小花瓶插花。' },
  { w: 'energy', p: '/ˈenədʒi/', pos: 'n.', zh: '能源；能量；精力', deck: 'junior', ex: 'Turning off lights when leaving saves energy as well as money.', exZh: '随手关灯既节约能源，又省钱。' },
  { w: 'earth', p: '/ɜːθ/', pos: 'n.', zh: '地球；土地', deck: 'junior', ex: 'Small daily actions can make the earth a better place to live.', exZh: '每天小小的行动，就能让地球成为更适合居住的地方。' },

  { w: 'message', p: '/ˈmesɪdʒ/', pos: 'n. / v.', zh: '信息；留言；口信', deck: 'junior', ex: 'She left me a short message about the time of the meeting.', exZh: '她给我留了个短信，说开会的时间。' },
  { w: 'information', p: '/ˌɪnfəˈmeɪʃn/', pos: 'n.', zh: '信息；消息；资料', deck: 'junior', ex: 'Be careful about personal information that you share on the internet.', exZh: '在网上分享个人信息时一定要小心。' },
  { w: 'online', p: '/ˌɒnˈlaɪn/', pos: 'adj. / adv.', zh: '在线的；联网的', deck: 'junior', ex: 'Many students buy school things online because it is fast and easy.', exZh: '很多学生在网上买学习用品，因为又快又方便。' },
  { w: 'internet', p: '/ˈɪntənet/', pos: 'n.', zh: '互联网；网络', deck: 'junior', ex: 'The internet makes it possible to learn anywhere and at any time.', exZh: '互联网让任何地方、任何时间的学习成为可能。' },
  { w: 'website', p: '/ˈwebsaɪt/', pos: 'n.', zh: '网站；站点', deck: 'junior', ex: 'This learning website offers free videos for students in middle school.', exZh: '这个学习网站为中学生免费提供视频。' },
  { w: 'download', p: '/ˌdaʊnˈləʊd/', pos: 'v. / n.', zh: '下载；下载的文件', deck: 'junior', ex: 'You can download the listening exercises from our class website tonight.', exZh: '今晚你可以从班级网站下载听力练习。' },
  { w: 'smartphone', p: '/ˈsmɑːtfəʊn/', pos: 'n.', zh: '智能手机', deck: 'junior', ex: 'He spends two hours on his smartphone every single evening.', exZh: '他每天晚上都要在智能手机上花两个小时。' },
  { w: 'search', p: '/sɜːtʃ/', pos: 'v. / n.', zh: '搜索；搜寻；搜查', deck: 'junior', ex: 'Search for the word again if you are not sure of it.', exZh: '如果不确定，就再搜索一下那个词。' },
  { w: 'email', p: '/ˈiːmeɪl/', pos: 'n. / v.', zh: '电子邮件；发电子邮件', deck: 'junior', ex: 'Please email the picture to me before Friday afternoon this week.', exZh: '请在这周周五下午之前把图片发到我邮箱。' },
  { w: 'magazine', p: '/ˌmæɡəˈziːn/', pos: 'n.', zh: '杂志；期刊', deck: 'junior', ex: 'Our student magazine prints interesting articles every other month.', exZh: '我们的学生杂志每隔两个月刊登一些有趣的文章。' },
  { w: 'novel', p: '/ˈnɒvl/', pos: 'n.', zh: '小说；长篇故事', deck: 'junior', ex: 'This long novel tells the story of a brave young sailor.', exZh: '这部长篇小说讲了一个勇敢年轻水手的故事。' },
  { w: 'writer', p: '/ˈraɪtə/', pos: 'n.', zh: '作家；作者', deck: 'junior', ex: 'The young writer described simple village life with beautiful words.', exZh: '这位年轻作家用优美的语言描写了朴实的乡村生活。' },
  { w: 'publish', p: '/ˈpʌblɪʃ/', pos: 'v.', zh: '出版；发表；公布', deck: 'junior', ex: 'Our school will publish the best essays of this term next spring.', exZh: '学校明年春天会发表这学期最优秀的作文。' },
  { w: 'technology', p: '/tekˈnɒlədʒi/', pos: 'n.', zh: '科技；技术', deck: 'junior', ex: 'Modern technology has changed the way we study and think.', exZh: '现代科技改变了我们学习和思考的方式。' },
  { w: 'invent', p: '/ɪnˈvent/', pos: 'v.', zh: '发明；创造', deck: 'junior', ex: 'Engineers invent new tools every year to solve everyday problems.', exZh: '工程师们每年发明新工具来解决日常问题。' },

  { w: 'cheer', p: '/tʃɪə/', pos: 'v. / n.', zh: '欢呼；使振奋；呐喊声', deck: 'junior', ex: 'The students cheered loudly when their team scored once more.', exZh: '球队再次得分时，学生们大声欢呼。' },
  { w: 'smile', p: '/smaɪl/', pos: 'n. / v.', zh: '微笑；笑容', deck: 'junior', ex: 'A warm smile makes people you have just met feel welcome.', exZh: '温暖的微笑能让初次见面的人立刻感到受欢迎。' },
  { w: 'laugh', p: '/lɑːf/', pos: 'v. / n.', zh: '笑；发笑；笑声', deck: 'junior', ex: 'We laughed together until our eyes watered during that show.', exZh: '看那出节目时，我们一起笑出了眼泪。' },
  { w: 'glad', p: '/ɡlæd/', pos: 'adj.', zh: '高兴的；乐意的', deck: 'junior', ex: 'I am glad to hear that you passed the difficult exam.', exZh: '听说你通过了那场难考的考试，我很高兴。' },
  { w: 'delighted', p: '/dɪˈlaɪtɪd/', pos: 'adj.', zh: '高兴的；欣喜的', deck: 'junior', ex: 'The children were delighted to find a gift on the desk.', exZh: '发现桌上有礼物，孩子们欣喜不已。' },
  { w: 'worried', p: '/ˈwʌrid/', pos: 'adj.', zh: '担心的；发愁的', deck: 'junior', ex: 'My mother looked worried until I finally came back home.', exZh: '直到我最终回家，妈妈一直显得忧心忡忡。' },
  { w: 'upset', p: '/ʌpˈset/', pos: 'adj. / v.', zh: '难过的；心烦的；打乱', deck: 'junior', ex: 'She felt upset because her best friend moved to another city.', exZh: '最好的朋友搬去了别的城市，她很难过。' },
  { w: 'afraid', p: '/əˈfreɪd/', pos: 'adj.', zh: '害怕的；恐怕', deck: 'junior', ex: 'Never be afraid of asking questions in front of your classmates.', exZh: '在同学面前提问，永远不要害怕。' },
  { w: 'calm', p: '/kɑːm/', pos: 'adj. / v.', zh: '冷静的；使平静', deck: 'junior', ex: 'Take a deep breath and stay calm before the important interview.', exZh: '重要面试之前，深呼吸，保持冷静。' },
  { w: 'pleased', p: '/pliːzd/', pos: 'adj.', zh: '高兴的；满意的', deck: 'junior', ex: 'Our teacher seemed pleased with the work of the whole class.', exZh: '老师对我们全班的表现似乎很满意。' },
  { w: 'embarrassed', p: '/ɪmˈbærəst/', pos: 'adj.', zh: '尴尬的；不好意思的', deck: 'junior', ex: 'He felt embarrassed when he forgot his lines on the stage.', exZh: '在台上忘词时，他觉得十分尴尬。' },
  { w: 'forgive', p: '/fəˈɡɪv/', pos: 'v.', zh: '原谅；宽恕', deck: 'junior', ex: 'It took me a week to forgive my friend for telling that lie.', exZh: '朋友那次撒谎，我花了一周才原谅他。' },
  { w: 'argue', p: '/ˈɑːɡjuː/', pos: 'v.', zh: '争论；争吵；主张', deck: 'junior', ex: 'Good friends sometimes argue with each other but always talk things through.', exZh: '好朋友有时也会争吵，但总会把话说开。' },
  { w: 'refuse', p: '/rɪˈfjuːz/', pos: 'v.', zh: '拒绝；不愿意', deck: 'junior', ex: 'He politely refused the invitation because he had to practise more.', exZh: '因为还要多练习，他礼貌地拒绝了邀请。' },

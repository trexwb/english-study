  {
    id: 's11',
    title: '建议信',
    en: 'Letter of Advice',
    when: '题目要求给某人提建议，常配“写一封信给你的朋友/学弟，就他的烦恼给些建议”。',
    outline: ['称呼与写信目的', '说明对方的处境', '建议一 + 理由', '建议二 + 理由', '鼓励与期待回信', '结尾敬语'],
    frames: [
      { en: 'Dear Mr. Li,', zh: '尊敬的李先生：（称呼顶格，后加逗号）' },
      { en: 'I am sorry to learn that you are having trouble with...', zh: '得知你在……方面遇到困扰，我很难过。' },
      { en: 'I am writing to share some suggestions about...', zh: '我写这封信是想就在……方面提几点建议。' },
      { en: 'It might help if you..., and you could also try...', zh: '如果你……也许会好一些；你也可以试试……。' },
      { en: 'I am sure things will work out if you follow this advice. I look forward to your reply.', zh: '照这些建议去做，情况一定会好转，期待你的回信。' },
      { en: 'Yours sincerely, Li Hua', zh: '李华 敬上（正式书信结尾敬语）' },
    ],
  },

  {
    id: 's12',
    title: '邀请信',
    en: 'Letter of Invitation',
    when: '题目要求邀请某人参加活动，如“邀请外教参加班会”“写邀请信请朋友来看英语戏剧节”。',
    outline: ['称呼与问候', '说明邀请内容与身份', '活动时间、地点与安排', '对方可参与的环节', '表达期待并请回复', '结尾敬语'],
    frames: [
      { en: 'Dear Ms. Smith,', zh: '尊敬的史密斯老师：' },
      { en: 'I am writing on behalf of our class to invite you to...', zh: '我谨代表全班邀请您参加……。' },
      { en: 'The event will be held in ... from ... to ... this Friday.', zh: '活动定于本周五在……举行，从……持续到……。' },
      { en: 'You will be able to enjoy ... as well as try ... yourself.', zh: '您既可以欣赏……，还能亲自体验……。' },
      { en: 'It would be a great honour to have you with us.', zh: '若能与您共度，我们将倍感荣幸。' },
      { en: 'Please let me know before ... whether you can come. Yours sincerely, Li Hua', zh: '请在……之前告知能否前来。李华 敬上。' },
    ],
  },

  {
    id: 's13',
    title: '感谢信',
    en: 'Letter of Thanks',
    when: '题目要求感谢他人的帮助或款待，如“写感谢信感谢寄宿家庭”“感谢老师帮你渡过难关”。',
    outline: ['称呼', '开门见山表达谢意', '回忆对方具体的帮助', '说明帮助带来的改变', '表达回报之意', '结尾敬语'],
    frames: [
      { en: 'Dear Mr. and Mrs. Green,', zh: '尊敬的格林先生、夫人：' },
      { en: 'I am writing to express my sincere thanks for...', zh: '我写这封信是为了对……表达我诚挚的谢意。' },
      { en: 'I still remember how you ... on my first day here.', zh: '我还记得初来乍到时您是如何……的。' },
      { en: 'Without your help, I could not have...', zh: '没有您的帮助，我不可能……。' },
      { en: 'What I appreciate most is that...', zh: '最让我感激的是……。' },
      { en: 'Thanks again, and I hope you can visit China someday. Yours sincerely, Li Hua', zh: '再次感谢，盼您有朝一日来中国做客。李华 敬上。' },
    ],
  },

  {
    id: 's14',
    title: '道歉信',
    en: 'Letter of Apology',
    when: '题目要求为做错的事或未守的约道歉，如“借坏了同学的词典”“没能赴约，写信说明并道歉”。',
    outline: ['称呼', '直接点明所歉之事', '简述经过与原因', '提出补救办法', '保证下不为例并请原谅', '结尾敬语'],
    frames: [
      { en: 'Dear Wang Lin,', zh: '王林：（朋友间直呼其名）' },
      { en: 'I am writing to make an apology to you for...', zh: '我写这封信是为……向你道歉。' },
      { en: 'I am terribly sorry that I ... without asking you first.', zh: '我没有征得同意就……，对此我深感抱歉。' },
      { en: 'The reason was that..., but that is no excuse.', zh: '原因是……，但这并不能成为借口。' },
      { en: 'To make up for it, I will... this weekend.', zh: '为了弥补，我会在本周末……。' },
      { en: 'Please accept my apology and give me a chance to make it right. Yours sincerely, Li Hua', zh: '请接受我的道歉，给我一个弥补的机会。李华 敬上。' },
    ],
  },

  {
    id: 's15',
    title: '申请信',
    en: 'Letter of Application',
    when: '题目要求申请某个职位或机会，如“申请当赛会志愿者”“写信申请加入英语社或交换项目”。',
    outline: ['称呼', '说明信息来源与申请职位', '个人基本情况', '相关经历与能力', '表达渴望与感谢', '结尾敬语'],
    frames: [
      { en: 'Dear Sir or Madam,', zh: '尊敬的负责人：（不知收信人姓名时的称呼）' },
      { en: 'I am writing to apply for the position of ..., which I learned about from...', zh: '我从……得知招聘信息，写信申请……一职。' },

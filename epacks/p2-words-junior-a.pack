  { w: 'subject', p: '/ˈsʌbdʒɪkt/', pos: 'n.', zh: '科目；学科；主题', deck: 'junior', ex: 'Maths is my favorite subject, and I enjoy solving hard problems.', exZh: '数学是我最喜欢的科目，我喜欢解难题。' },
  { w: 'geography', p: '/dʒiˈɒɡrəfi/', pos: 'n.', zh: '地理；地理学', deck: 'junior', ex: 'Geography helps us understand why people live where they do.', exZh: '地理帮助我们理解人们为什么住在某个地方。' },
  { w: 'chemistry', p: '/ˈkɛmɪstri/', pos: 'n.', zh: '化学；化学课', deck: 'junior', ex: 'Chemistry lessons teach us to observe carefully and record results.', exZh: '化学课教会我们仔细观察并记录结果。' },
  { w: 'physics', p: '/ˈfɪzɪks/', pos: 'n.', zh: '物理学；物理课', deck: 'junior', ex: 'I find physics difficult, but experiments make the ideas clearer.', exZh: '我觉得物理很难，但实验让概念更清楚了。' },
  { w: 'history', p: '/ˈhɪstəri/', pos: 'n.', zh: '历史；历史课', deck: 'junior', ex: 'Our history teacher tells stories that make the past come alive.', exZh: '我们的历史老师讲故事，让过去变得生动起来。' },
  { w: 'grammar', p: '/ˈɡræmər/', pos: 'n.', zh: '语法', deck: 'junior', ex: 'Reading short English articles every day is a good way to learn grammar.', exZh: '每天读短文是学习语法的好方法。' },
  { w: 'exam', p: '/ɪɡˈzæm/', pos: 'n.', zh: '考试', deck: 'junior', ex: 'We will take the final English exam next Friday morning.', exZh: '我们下周五上午要参加英语期末考试。' },
  { w: 'quiz', p: '/kwɪz/', pos: 'n.', zh: '小测验；知识抢答', deck: 'junior', ex: 'Our maths quiz covers the three units we finished this month.', exZh: '我们这次数学小测涵盖本月学完的三个单元。' },
  { w: 'grade', p: '/ɡreɪd/', pos: 'n.', zh: '成绩；年级；等级', deck: 'junior', ex: 'I got a good grade in the maths exam last term.', exZh: '上学期我数学考试取得了好成绩。' },
  { w: 'mark', p: '/mɑːrk/', pos: 'n. / v.', zh: '分数；做记号；表示', deck: 'junior', ex: 'Every mark on the report shows the effort of a whole year.', exZh: '成绩单上的每个分数都体现了一整年的努力。' },
  { w: 'homework', p: '/ˈhəʊmwɜːrk/', pos: 'n.', zh: '家庭作业', deck: 'junior', ex: 'I usually finish my homework before dinner and then read for an hour.', exZh: '我通常在晚饭前写完作业，然后读一小时书。' },
  { w: 'practice', p: '/ˈpræktɪs/', pos: 'n. / v.', zh: '练习；实践', deck: 'junior', ex: 'Daily practice with short passages improved my listening a lot.', exZh: '每天用短文练习大大提高了我的听力。' },
  { w: 'revision', p: '/rɪˈvɪʒən/', pos: 'n.', zh: '复习；修订', deck: 'junior', ex: 'A week of revision before the exam helped me feel calm.', exZh: '考前一周的复习让我心里踏实多了。' },
  { w: 'notebook', p: '/ˈnoʊtbʊk/', pos: 'n.', zh: '笔记本；笔记', deck: 'junior', ex: 'I write new words in a small notebook and review them nightly.', exZh: '我把生词记在一个小本子上，每天晚上复习。' },
  { w: 'dictionary', p: '/ˈdɪkʃəneri/', pos: 'n.', zh: '词典；字典', deck: 'junior', ex: 'Look up the word in a dictionary if you are not sure.', exZh: '如果不确定，就查一下词典。' },
  { w: 'textbook', p: '/ˈtɛkstbʊk/', pos: 'n.', zh: '教科书；课本', deck: 'junior', ex: 'The pictures in our English textbook make each story easy to follow.', exZh: '英语课本里的插图让每个故事都容易读懂。' },
  { w: 'classmate', p: '/ˈklæsmeɪt/', pos: 'n.', zh: '同班同学', deck: 'junior', ex: 'My classmate lent me her notes when I was ill last week.', exZh: '上周我生病时，同学把笔记借给了我。' },
  { w: 'principal', p: '/ˈprɪnsəpəl/', pos: 'n.', zh: '校长', deck: 'junior', ex: 'The principal asked us to be kind to younger students.', exZh: '校长要求我们对低年级同学友善。' },
  { w: 'lab', p: '/læb/', pos: 'n.', zh: '实验室', deck: 'junior', ex: 'We do science experiments in the lab every Wednesday afternoon.', exZh: '我们每周三下午在实验室做科学实验。' },
  { w: 'playground', p: '/ˈpleɪɡraʊnd/', pos: 'n.', zh: '操场；游乐场', deck: 'junior', ex: 'We play basketball on the playground during the long break.', exZh: '大课间时，我们在操场上打篮球。' },
  { w: 'club', p: '/klʌb/', pos: 'n.', zh: '社团；俱乐部', deck: 'junior', ex: 'Joining the English club gives me more chances to speak in public.', exZh: '参加英语社团给了我更多当众开口说英语的机会。' },
  { w: 'question', p: '/ˈkwɛstʃən/', pos: 'n.', zh: '问题；疑问', deck: 'junior', ex: 'Do not be afraid to ask a question when you do not understand.', exZh: '不明白的时候，不要害怕提问。' },
  { w: 'answer', p: '/ˈænsər/', pos: 'n. / v.', zh: '答案；回答；答复', deck: 'junior', ex: 'Write your answer on the paper and check it twice before handing it in.', exZh: '把答案写在卷子上，交卷前检查两遍。' },
  { w: 'explain', p: '/ɪkˈspleɪn/', pos: 'v.', zh: '解释；说明；讲解', deck: 'junior', ex: 'Our teacher always explains new words with simple examples.', exZh: '老师总是用简单的例子来讲解生词。' },
  { w: 'correct', p: '/kəˈrɛkt/', pos: 'adj. / v.', zh: '正确的；改正', deck: 'junior', ex: 'Please correct your mistakes in red pen after every test.', exZh: '每次测验后请用红笔改正错误。' },
  { w: 'understand', p: '/ˌʌndərˈstænd/', pos: 'v.', zh: '理解；明白', deck: 'junior', ex: 'I understand this article better after reading it a second time.', exZh: '再读一遍后，我对这篇文章理解得更透彻了。' },
  { w: 'memorize', p: '/ˈmɛməraɪz/', pos: 'v.', zh: '记忆；背诵', deck: 'junior', ex: 'Do not try to memorize every word; learn the useful ones first.', exZh: '不要试图记住每个单词，先学最有用的那些。' },
  { w: 'routine', p: '/ruːˈtiːn/', pos: 'n.', zh: '日常安排；惯例', deck: 'junior', ex: 'My daily routine is simple: early classes, sport, dinner, and reading.', exZh: '我的作息很简单：早课、运动、晚饭和阅读。' },
  { w: 'wake', p: '/weɪk/', pos: 'v.', zh: '醒来；唤醒', deck: 'junior', ex: 'I wake up at six thirty to have time for breakfast.', exZh: '我六点半起床，好有时间吃早饭。' },
  { w: 'breakfast', p: '/ˈbrɛkfəst/', pos: 'n.', zh: '早餐；早饭', deck: 'junior', ex: 'A good breakfast gives you energy for the whole morning.', exZh: '一顿丰盛的早餐为你整个上午提供能量。' },
  { w: 'meal', p: '/miːl/', pos: 'n.', zh: '一餐；饭菜', deck: 'junior', ex: 'Skipping a meal before class makes it hard to concentrate.', exZh: '上课前不吃饭会让人难以集中注意力。' },
  { w: 'vegetable', p: '/ˈvɛdʒtəbəl/', pos: 'n.', zh: '蔬菜', deck: 'junior', ex: 'Eating a green vegetable every day helps you stay strong.', exZh: '每天吃一种绿色蔬菜有助于你保持强壮。' },
  { w: 'diet', p: '/ˈdaɪət/', pos: 'n.', zh: '饮食；日常食物', deck: 'junior', ex: 'A balanced diet and enough sleep keep illness away.', exZh: '均衡的饮食和充足的睡眠能让人少生病。' },
  { w: 'brush', p: '/brʌʃ/', pos: 'v. / n.', zh: '刷；擦；刷子', deck: 'junior', ex: 'You should brush your teeth twice a day, morning and night.', exZh: '你应该每天早晚各刷一次牙。' },
  { w: 'toothache', p: '/ˈtuːθeɪk/', pos: 'n.', zh: '牙痛', deck: 'junior', ex: 'The dentist looked at my toothache and gave me some medicine.', exZh: '牙医看了看我的牙痛，给了我一些药。' },
  { w: 'headache', p: '/ˈhɛdeɪk/', pos: 'n.', zh: '头痛', deck: 'junior', ex: 'I got a headache after studying for three hours without a break.', exZh: '连续学了三个小时不休息，我头痛了。' },
  { w: 'cough', p: '/kɒf/', pos: 'n. / v.', zh: '咳嗽', deck: 'junior', ex: 'A bad cough kept him awake through the whole night.', exZh: '剧烈的咳嗽让他整夜无法入睡。' },
  { w: 'medicine', p: '/ˈmɛdsən/', pos: 'n.', zh: '药；医学', deck: 'junior', ex: 'Take this medicine three times a day after each meal.', exZh: '这种药一日三次，每次饭后服用。' },
  { w: 'hospital', p: '/ˈhɒspɪtəl/', pos: 'n.', zh: '医院', deck: 'junior', ex: 'My grandmother stayed in hospital for five days after her operation.', exZh: '奶奶手术后住院住了五天。' },
  { w: 'healthy', p: '/ˈhɛlθi/', pos: 'adj.', zh: '健康的；有益健康的', deck: 'junior', ex: 'Walking to school every day keeps me fit and healthy.', exZh: '每天走路上学让我保持健康。' },
  { w: 'sleep', p: '/sliːp/', pos: 'n. / v.', zh: '睡眠；睡觉', deck: 'junior', ex: 'Teenagers need about eight hours of sleep every night.', exZh: '青少年每晚大约需要八小时睡眠。' },
  { w: 'housework', p: '/ˈhaʊswɜːrk/', pos: 'n.', zh: '家务；家务劳动', deck: 'junior', ex: 'Doing housework on weekends teaches us skills that schools cannot give.', exZh: '周末做家务教会我们学校里学不到的本领。' },
  { w: 'sweep', p: '/swiːp/', pos: 'v.', zh: '扫；打扫', deck: 'junior', ex: 'Please sweep the floor and then take the dust outside.', exZh: '请把地扫了，然后把垃圾拿出去。' },
  { w: 'tidy', p: '/ˈtaɪdi/', pos: 'adj. / v.', zh: '整洁的；收拾整齐', deck: 'junior', ex: 'Keep your desk tidy so you can find things quickly.', exZh: '把书桌保持整洁，这样找东西就快。' },
  { w: 'dish', p: '/dɪʃ/', pos: 'n.', zh: '盘子；一道菜', deck: 'junior', ex: 'After dinner I wash the dishes while my sister dries them.', exZh: '晚饭后我洗碗，姐姐把碗擦干。' },
  { w: 'allowance', p: '/əˈlaʊəns/', pos: 'n.', zh: '零花钱；津贴；定量', deck: 'junior', ex: 'My parents give me a small allowance every month.', exZh: '父母每月给我一点零花钱。' },
  { w: 'save', p: '/seɪv/', pos: 'v.', zh: '攒钱；节省；挽救', deck: 'junior', ex: 'I save part of my allowance each month for a new bike.', exZh: '我每月存下一部分零花钱，想买辆新自行车。' },
  { w: 'spend', p: '/spɛnd/', pos: 'v.', zh: '花费；度过', deck: 'junior', ex: 'Do not spend all your pocket money on snacks and drinks.', exZh: '不要把零花钱都花在零食和饮料上。' },
  { w: 'price', p: '/praɪs/', pos: 'n.', zh: '价格；价钱', deck: 'junior', ex: 'The shop lowered the price of that dictionary by half.', exZh: '这家店把那本词典的价格降了一半。' },
  { w: 'expensive', p: '/ɪkˈspɛnsɪv/', pos: 'adj.', zh: '昂贵的；花钱多的', deck: 'junior', ex: 'That jacket is too expensive, so I will wait for a sale.', exZh: '那件夹克太贵了，我打算等打折再买。' },
  { w: 'customer', p: '/ˈkʌstəmər/', pos: 'n.', zh: '顾客；客户', deck: 'junior', ex: 'A good shop assistant listens carefully to every customer.', exZh: '好的售货员会认真倾听每位顾客的要求。' },
  { w: 'wear', p: '/wɛər/', pos: 'v.', zh: '穿；戴；留（胡须）', deck: 'junior', ex: 'Students must wear their school uniform on Monday mornings.', exZh: '学生们周一上午必须穿校服。' },
  { w: 'size', p: '/saɪz/', pos: 'n.', zh: '尺码；大小', deck: 'junior', ex: 'Ask for a larger size if these shoes feel tight.', exZh: '如果这双鞋穿着紧，就换大一号的。' },
  { w: 'friendship', p: '/ˈfrɛndʃɪp/', pos: 'n.', zh: '友谊；友情', deck: 'junior', ex: 'True friendship grows when both people help each other.', exZh: '当两个人互相帮助时，真正的友谊才会成长。' },
  { w: 'argue', p: '/ˈɑːrɡjuː/', pos: 'v.', zh: '争吵；争论', deck: 'junior', ex: 'My best friend and I once argued about a funny film.', exZh: '我和最好的朋友曾经为一部有趣的电影争吵过。' },
  { w: 'share', p: '/ʃɛər/', pos: 'v.', zh: '分享；共用', deck: 'junior', ex: 'Sharing your ideas in class helps everyone learn something new.', exZh: '在课堂上分享想法有助于每个人学到新东西。' },
  { w: 'offer', p: '/ˈɒfər/', pos: 'v. / n.', zh: '主动提供；给予；提议', deck: 'junior', ex: 'When a classmate struggles, I offer to explain the steps again.', exZh: '同学遇到困难时，我会主动再讲一遍步骤。' },
  { w: 'smile', p: '/smaɪl/', pos: 'n. / v.', zh: '微笑', deck: 'junior', ex: 'Her warm smile made me feel welcome on my first day.', exZh: '她温暖的微笑让我在第一天就感到受欢迎。' },
  { w: 'laugh', p: '/læf/', pos: 'v. / n.', zh: '笑；大笑', deck: 'junior', ex: 'We laughed together until our sides hurt during the game.', exZh: '比赛时我们笑个不停。' },
  { w: 'angry', p: '/ˈæŋɡri/', pos: 'adj.', zh: '生气的；愤怒的', deck: 'junior', ex: 'Do not shout when you are angry; take a deep breath first.', exZh: '生气时不要大喊，先深呼吸。' },
  { w: 'afraid', p: '/əˈfreɪd/', pos: 'adj.', zh: '害怕的；担心的', deck: 'junior', ex: 'I was afraid to speak English, but my teacher encouraged me.', exZh: '我过去害怕说英语，但老师鼓励了我。' },
  { w: 'worried', p: '/ˈwɜːrid/', pos: 'adj.', zh: '担心的；发愁的', deck: 'junior', ex: 'My mother looked worried until I told her my good grade.', exZh: '妈妈一直面带愁容，直到我告诉了她的好成绩。' },
  { w: 'excited', p: '/ɪkˈsaɪtɪd/', pos: 'adj.', zh: '兴奋的；激动的', deck: 'junior', ex: 'The whole class was excited about the school sports meeting.', exZh: '全班同学对学校运动会都感到很兴奋。' },
  { w: 'disappointed', p: '/ˌdɪsəˈpɔɪntɪd/', pos: 'adj.', zh: '失望的；沮丧的', deck: 'junior', ex: 'He felt disappointed at his score but decided to try again.', exZh: '他对分数感到失望，但还是决定再试一次。' },
  { w: 'believe', p: '/bɪˈliːv/', pos: 'v.', zh: '相信；认为', deck: 'junior', ex: 'I believe that honest effort is worth more than a high mark.', exZh: '我相信诚实的努力比高分更可贵。' },
  { w: 'forgive', p: '/fərˈɡɪv/', pos: 'v.', zh: '原谅；宽恕', deck: 'junior', ex: 'Please forgive me for forgetting your book; I will bring it tomorrow.', exZh: '请原谅我忘了带你的书，我明天带来。' },
  { w: 'agree', p: '/əˈɡriː/', pos: 'v.', zh: '同意；赞成；一致', deck: 'junior', ex: 'We agreed that taking turns is the fairest way to play.', exZh: '我们一致认为轮流玩是最公平的方式。' },
  { w: 'invite', p: '/ɪnˈvaɪt/', pos: 'v.', zh: '邀请', deck: 'junior', ex: 'Our class invited the new students to visit the school library.', exZh: '我们班邀请新同学参观了学校图书馆。' },
  { w: 'introduce', p: '/ˌɪntrəˈduːs/', pos: 'v.', zh: '介绍；引进', deck: 'junior', ex: 'The teacher asked me to introduce myself in simple English.', exZh: '老师让我用简单的英语自我介绍。' },
  { w: 'praise', p: '/preɪz/', pos: 'v. / n.', zh: '表扬；赞美', deck: 'junior', ex: 'Our coach praised the team for never giving up.', exZh: '教练表扬了球队从不放弃。' },
  { w: 'joke', p: '/dʒoʊk/', pos: 'n. / v.', zh: '笑话；玩笑', deck: 'junior', ex: 'A little joke can break the ice when you meet someone new.', exZh: '初次见面时，一句小玩笑能打破拘谨。' },
  { w: 'greet', p: '/ɡriːt/', pos: 'v.', zh: '问候；迎接', deck: 'junior', ex: 'Always greet your teachers with a smile when you meet them.', exZh: '遇到老师时，总要微笑着打招呼。' },
  { w: 'promise', p: '/ˈprɑːmɪs/', pos: 'n. / v.', zh: '承诺；答应', deck: 'junior', ex: 'I promise to keep the classroom clean during our duty week.', exZh: '我保证在值周期间保持教室干净。' },
  { w: 'truth', p: '/truːθ/', pos: 'n.', zh: '真相；事实', deck: 'junior', ex: 'Telling the truth costs nothing but saves a friendship.', exZh: '说真话不费什么，却能挽救一份友谊。' },
  { w: 'lie', p: '/laɪ/', pos: 'n. / v.', zh: '谎言；说谎', deck: 'junior', ex: 'A small lie at home can make a bigger problem later.', exZh: '在家撒的一个小谎，以后可能变成更大的麻烦。' },
  { w: 'effort', p: '/ˈɛfərt/', pos: 'n.', zh: '努力；气力', deck: 'junior', ex: 'Every effort you make today will show up in your writing.', exZh: '你今天下的每分力气，都会体现在你的文章里。' },
  { w: 'fail', p: '/feɪl/', pos: 'v.', zh: '失败；不及格；未能', deck: 'junior', ex: 'If you fail a test, ask the teacher what to review.', exZh: '如果考试没考好，就问老师该复习什么。' },
  { w: 'insist', p: '/ɪnˈsɪst/', pos: 'v.', zh: '坚持；坚决要求', deck: 'junior', ex: 'My parents insist that I finish my homework before watching television.', exZh: '父母坚持要我先写完作业再看电视。' },
  { w: 'decide', p: '/dɪˈsaɪd/', pos: 'v.', zh: '决定；判断', deck: 'junior', ex: 'It took me a week to decide which club to join.', exZh: '我花了一周才决定加入哪个社团。' },
  { w: 'selfish', p: '/ˈselfɪʃ/', pos: 'adj.', zh: '自私的', deck: 'junior', ex: 'A selfish child refuses to share and slowly loses good friends.', exZh: '自私的孩子不肯分享，会慢慢失去好朋友。' },
  { w: 'generous', p: '/ˈdʒɛnərəs/', pos: 'adj.', zh: '慷慨的；大方的', deck: 'junior', ex: 'He is generous with his time and often helps younger students.', exZh: '他乐意付出时间，常常帮助低年级同学。' },
  { w: 'strict', p: '/strɪkt/', pos: 'adj.', zh: '严格的；严厉的', deck: 'junior', ex: 'Our maths teacher is strict about homework but fair to everyone.', exZh: '我们数学老师对作业要求严格，但对每个人都公平。' },
  { w: 'modest', p: '/ˈmɑːdɪst/', pos: 'adj.', zh: '谦虚的；不多的', deck: 'junior', ex: 'Although she won first prize, she stayed modest and kept working.', exZh: '虽然获得一等奖，她依然谦虚，继续努力。' },
  { w: 'outgoing', p: '/ˈaʊtɡoʊɪŋ/', pos: 'adj.', zh: '外向的；开朗的', deck: 'junior', ex: 'Speaking in class helped the quiet boy become more outgoing.', exZh: '课堂发言帮助这个安静的男孩变得更开朗。' },
  { w: 'active', p: '/ˈæktɪv/', pos: 'adj.', zh: '积极的；活跃的；主动的', deck: 'junior', ex: 'Try to take an active part in every class discussion.', exZh: '要积极参与每一次课堂讨论。' },
  { w: 'creative', p: '/kriˈeɪtɪv/', pos: 'adj.', zh: '有创造力的；创新的', deck: 'junior', ex: 'Drawing mind maps is a creative way to plan an essay.', exZh: '画思维导图是一种有创意的作文规划方法。' },
  { w: 'influence', p: '/ˈɪnfluəns/', pos: 'n. / v.', zh: '影响；作用', deck: 'junior', ex: 'A good teacher can influence how students see themselves.', exZh: '一位好老师能影响学生看待自己的方式。' },
  { w: 'example', p: '/ɪɡˈzæmpəl/', pos: 'n.', zh: '例子；榜样', deck: 'junior', ex: 'Older students should set a good example for the younger ones.', exZh: '高年级学生应为低年级同学树立好榜样。' },
  { w: 'admire', p: '/ədˈmaɪər/', pos: 'v.', zh: '钦佩；赞赏', deck: 'junior', ex: 'I admire my friend because she never complains about hard work.', exZh: '我佩服我的朋友，因为她从不抱怨辛苦。' },

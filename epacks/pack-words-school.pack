  { w: 'advice', p: '/ədˈvaɪs/', pos: 'n.', zh: '建议；忠告', deck: 'junior', ex: 'Thank you for your advice on choosing high schools.', exZh: '谢谢你在择校方面给我的建议。' },
  { w: 'achieve', p: '/əˈtʃiːv/', pos: 'v.', zh: '实现；达到', deck: 'junior', ex: 'You can achieve your dream through hard work.', exZh: '通过努力，你能实现自己的梦想。' },
  { w: 'attention', p: '/əˈtenʃn/', pos: 'n.', zh: '注意；专心', deck: 'junior', ex: 'Please pay attention to the key words in the question.', exZh: '请注意题目中的关键词。' },
  { w: 'communicate', p: '/kəˈmjuːnɪkeɪt/', pos: 'v.', zh: '交流；沟通', deck: 'junior', ex: 'We often communicate with our teachers after class.', exZh: '我们课后经常和老师交流。' },
  { w: 'environment', p: '/ɪnˈvaɪrənmənt/', pos: 'n.', zh: '环境', deck: 'junior', ex: 'Everyone should do something to protect the environment.', exZh: '每个人都应该为保护环境出一份力。' },
  { w: 'patient', p: '/ˈpeɪʃnt/', pos: 'adj. / n.', zh: '耐心的；病人', deck: 'junior', ex: 'The teacher is patient with every student in class.', exZh: '这位老师对班里每个学生都很有耐心。' },
  { w: 'polite', p: '/pəˈlaɪt/', pos: 'adj.', zh: '有礼貌的', deck: 'junior', ex: 'It is polite to say thank you when someone helps you.', exZh: '有人帮了你，说声谢谢才是有礼貌的。' },
  { w: 'progress', p: '/ˈprɑːɡres/', pos: 'n.', zh: '进步；进展', deck: 'junior', ex: 'Li Ming has made great progress in English this term.', exZh: '李明这学期英语进步很大。' },
  { w: 'realize', p: '/ˈriːəlaɪz/', pos: 'v.', zh: '意识到；实现', deck: 'junior', ex: 'He did not realize his mistake until the teacher talked with him.', exZh: '直到老师找他谈话，他才意识到自己的错误。' },
  { w: 'responsible', p: '/rɪˈspɑːnsəbl/', pos: 'adj.', zh: '负责的；有责任心的', deck: 'junior', ex: 'As the monitor, she is responsible for cleaning the classroom.', exZh: '作为班长，她负责打扫教室。' },
  { w: 'volunteer', p: '/ˌvɑːlənˈtɪr/', pos: 'n. / v.', zh: '志愿者；自愿做', deck: 'junior', ex: 'Many students volunteer to clean the park on weekends.', exZh: '许多学生周末自愿去公园打扫卫生。' },
  { w: 'afford', p: '/əˈfɔːrd/', pos: 'v.', zh: '买得起；承担得起', deck: 'junior', ex: 'This bike is too expensive, so I cannot afford it.', exZh: '这辆自行车太贵了，我买不起。' },
  { w: 'apologize', p: '/əˈpɑːlədʒaɪz/', pos: 'v.', zh: '道歉', deck: 'junior', ex: 'You should apologize to your friend for being late.', exZh: '你迟到了，应该向朋友道歉。' },
  { w: 'ancient', p: '/ˈeɪnʃənt/', pos: 'adj.', zh: '古代的；古老的', deck: 'junior', ex: 'The museum shows many treasures from ancient China.', exZh: '这座博物馆展出了许多中国古代的珍宝。' },
  { w: 'balance', p: '/ˈbæləns/', pos: 'n. / v.', zh: '平衡；使平衡', deck: 'junior', ex: 'Try to keep a balance between study and rest.', exZh: '尽量在学习与休息之间保持平衡。' },
  { w: 'brave', p: '/breɪv/', pos: 'adj.', zh: '勇敢的', deck: 'junior', ex: 'The brave boy jumped into the river to save the child.', exZh: '那个勇敢的男孩跳进河里救起了孩子。' },
  { w: 'celebrate', p: '/ˈselɪbreɪt/', pos: 'v.', zh: '庆祝', deck: 'junior', ex: 'We will celebrate her birthday with a small party.', exZh: '我们要用一个小派对为她庆祝生日。' },
  { w: 'century', p: '/ˈsentʃəri/', pos: 'n.', zh: '世纪；一百年', deck: 'junior', ex: 'This bridge has stood there for over a century.', exZh: '这座桥已经在那里矗立了一个多世纪。' },
  { w: 'challenge', p: '/ˈtʃælɪndʒ/', pos: 'n. / v.', zh: '挑战', deck: 'junior', ex: 'Learning a new language is a big challenge for me.', exZh: '学一门新语言对我来说是个很大的挑战。' },
  { w: 'courage', p: '/ˈkɜːrɪdʒ/', pos: 'n.', zh: '勇气', deck: 'junior', ex: 'It takes courage to speak in front of the whole class.', exZh: '敢于在全班面前发言是需要勇气的。' },
  { w: 'culture', p: '/ˈkʌltʃər/', pos: 'n.', zh: '文化', deck: 'junior', ex: 'Our school invites foreign teachers to talk about their culture.', exZh: '学校邀请外教介绍他们国家的文化。' },
  { w: 'describe', p: '/dɪˈskraɪb/', pos: 'v.', zh: '描述；描写', deck: 'junior', ex: 'Can you describe what the thief looked like?', exZh: '你能描述一下那个小偷的长相吗？' },
  { w: 'encourage', p: '/ɪnˈkɜːrɪdʒ/', pos: 'v.', zh: '鼓励', deck: 'junior', ex: 'My parents always encourage me to try new things.', exZh: '父母总是鼓励我尝试新事物。' },
  { w: 'especially', p: '/ɪˈspeʃəli/', pos: 'adv.', zh: '尤其；特别', deck: 'junior', ex: 'I love all kinds of fruit, especially watermelons in summer.', exZh: '水果我都爱吃，夏天的西瓜更是如此。' },
  { w: 'experience', p: '/ɪkˈspɪriəns/', pos: 'n. / v.', zh: '经历；经验', deck: 'junior', ex: 'Working as a volunteer was a wonderful experience for me.', exZh: '做志愿者对我来说是一次很棒的经历。' },
  { w: 'familiar', p: '/fəˈmɪliər/', pos: 'adj.', zh: '熟悉的', deck: 'junior', ex: 'This song sounds familiar, but I cannot remember its name.', exZh: '这首歌听着耳熟，但我记不起名字了。' },
  { w: 'freedom', p: '/ˈfriːdəm/', pos: 'n.', zh: '自由', deck: 'junior', ex: 'Birds in the wild enjoy the freedom of the sky.', exZh: '野外的鸟儿享受着天空的自由。' },
  { w: 'habit', p: '/ˈhæbɪt/', pos: 'n.', zh: '习惯', deck: 'junior', ex: 'Reading before bed is a good habit worth keeping.', exZh: '睡前阅读是个值得保持的好习惯。' },
  { w: 'honest', p: '/ˈɑːnɪst/', pos: 'adj.', zh: '诚实的', deck: 'junior', ex: 'An honest person never tells lies to friends.', exZh: '诚实的人从不向朋友撒谎。' },
  { w: 'imagine', p: '/ɪˈmædʒɪn/', pos: 'v.', zh: '想象', deck: 'junior', ex: 'Just imagine what our life would be like without phones.', exZh: '想想看，要是没有手机，生活会是什么样。' },
  { w: 'improve', p: '/ɪmˈpruːv/', pos: 'v.', zh: '提高；改进', deck: 'junior', ex: 'Reading aloud every morning can improve your spoken English.', exZh: '每天早上大声朗读能提高你的口语。' },
  { w: 'independent', p: '/ˌɪndɪˈpendənt/', pos: 'adj.', zh: '独立的；自主的', deck: 'junior', ex: 'She became more independent after living at school.', exZh: '住校以后，她变得更加独立了。' },
  { w: 'journey', p: '/ˈdʒɜːrni/', pos: 'n.', zh: '旅行；旅程', deck: 'junior', ex: 'The train journey to Tibet took them two days.', exZh: '乘火车去西藏的旅程花了他们两天。' },
  { w: 'knowledge', p: '/ˈnɑːlɪdʒ/', pos: 'n.', zh: '知识', deck: 'junior', ex: 'Books open a door to a world full of knowledge.', exZh: '书籍为我们打开了通往知识世界的大门。' },
  { w: 'lonely', p: '/ˈloʊnli/', pos: 'adj.', zh: '孤独的；寂寞的', deck: 'junior', ex: 'The old man felt lonely after his children moved away.', exZh: '孩子们搬走后，老人感到很孤独。' },
  { w: 'mistake', p: '/mɪˈsteɪk/', pos: 'n. / v.', zh: '错误；犯错误', deck: 'junior', ex: 'Do not be afraid of making mistakes when learning English.', exZh: '学英语时不要怕犯错误。' },
  { w: 'nervous', p: '/ˈnɜːrvəs/', pos: 'adj.', zh: '紧张的；不安的', deck: 'junior', ex: 'I always feel nervous before an important exam.', exZh: '重要考试前我总会紧张。' },
  { w: 'opinion', p: '/əˈpɪnjən/', pos: 'n.', zh: '意见；看法', deck: 'junior', ex: 'In my opinion, doing sports makes us study better.', exZh: '在我看来，多做运动能让我们学得更好。' },
  { w: 'opportunity', p: '/ˌɑːpərˈtuːnəti/', pos: 'n.', zh: '机会；时机', deck: 'junior', ex: 'This contest is a good opportunity to show yourself.', exZh: '这次比赛是展示自我的好机会。' },
  { w: 'organize', p: '/ˈɔːrɡənaɪz/', pos: 'v.', zh: '组织；安排', deck: 'junior', ex: 'Our class will organize a charity sale next Friday.', exZh: '我们班下周五要组织一次义卖活动。' },
  { w: 'perfect', p: '/ˈpɜːrfɪkt/', pos: 'adj.', zh: '完美的；极好的', deck: 'junior', ex: 'Nobody is perfect, so do not be too hard on yourself.', exZh: '人无完人，别对自己太苛刻。' },
  { w: 'prefer', p: '/prɪˈfɜːr/', pos: 'v.', zh: '更喜欢；宁愿', deck: 'junior', ex: 'I prefer walking to school on sunny days.', exZh: '晴天时我更愿意走路去上学。' },
  { w: 'prepare', p: '/prɪˈper/', pos: 'v.', zh: '准备；预备', deck: 'junior', ex: 'We are preparing for the coming final exams.', exZh: '我们正在为期末考试做准备。' },
  { w: 'prevent', p: '/prɪˈvent/', pos: 'v.', zh: '防止；阻止', deck: 'junior', ex: 'Washing hands often can prevent the spread of illness.', exZh: '勤洗手能防止疾病传播。' },
  { w: 'protect', p: '/prəˈtekt/', pos: 'v.', zh: '保护', deck: 'junior', ex: 'We should protect wild animals and their homes.', exZh: '我们应当保护野生动物及其家园。' },
  { w: 'proud', p: '/praʊd/', pos: 'adj.', zh: '自豪的；骄傲的', deck: 'junior', ex: 'Her parents were proud of her prize in the contest.', exZh: '她在比赛中获奖，父母很自豪。' },
  { w: 'provide', p: '/prəˈvaɪd/', pos: 'v.', zh: '提供', deck: 'junior', ex: 'The school provides free lunch for students in need.', exZh: '学校为有困难的学生提供免费午餐。' },
  { w: 'purpose', p: '/ˈpɜːrpəs/', pos: 'n.', zh: '目的；意图', deck: 'junior', ex: 'What is the purpose of this school trip?', exZh: '这次学校出游的目的是什么？' },
  { w: 'reason', p: '/ˈriːzn/', pos: 'n.', zh: '原因；理由', deck: 'junior', ex: 'Please tell me the reason for your absence today.', exZh: '请告诉我你今天缺勤的原因。' },
  { w: 'respect', p: '/rɪˈspekt/', pos: 'v. / n.', zh: '尊重；敬意', deck: 'junior', ex: 'We should respect our parents and listen to them.', exZh: '我们要尊重父母，多听听他们的想法。' },
  { w: 'sense', p: '/sens/', pos: 'n.', zh: '感觉；判断力', deck: 'junior', ex: 'My sense of direction is poor, so I often get lost.', exZh: '我方向感很差，所以经常迷路。' },
  { w: 'serious', p: '/ˈsɪriəs/', pos: 'adj.', zh: '严重的；严肃的', deck: 'junior', ex: 'Air pollution is a serious problem in many big cities.', exZh: '空气污染是许多大城市面临的严重问题。' },
  { w: 'skill', p: '/skɪl/', pos: 'n.', zh: '技能；技巧', deck: 'junior', ex: 'Cooking is a useful life skill for every student.', exZh: '做饭对学生来说是一项实用的生活技能。' },
  { w: 'solve', p: '/sɑːlv/', pos: 'v.', zh: '解决；解答', deck: 'junior', ex: 'Working together helps us solve difficult math problems.', exZh: '合作能帮我们解出复杂的数学题。' },
  { w: 'suggest', p: '/səˈdʒest/', pos: 'v.', zh: '建议；暗示', deck: 'junior', ex: 'My friend suggests going over the notes before the test.', exZh: '朋友建议我考试前把笔记过一遍。' },
  { w: 'succeed', p: '/səkˈsiːd/', pos: 'v.', zh: '成功', deck: 'junior', ex: 'If you keep trying, you will succeed in the end.', exZh: '只要坚持下去，你终会成功。' },
  { w: 'support', p: '/səˈpɔːrt/', pos: 'v. / n.', zh: '支持；支撑', deck: 'junior', ex: 'Thanks for your support during my hard times.', exZh: '谢谢你在我难熬的日子里给予的支持。' },
  { w: 'surprise', p: '/sərˈpraɪz/', pos: 'n. / v.', zh: '惊喜；使惊讶', deck: 'junior', ex: 'To my surprise, the shy boy won the speech contest.', exZh: '令我惊讶的是，那个害羞的男孩居然赢得了演讲比赛。' },
  { w: 'trust', p: '/trʌst/', pos: 'v. / n.', zh: '信任；相信', deck: 'junior', ex: 'A true friend is someone you can always trust.', exZh: '真正的朋友是永远值得信任的人。' },
  { w: 'valuable', p: '/ˈvæljuəbl/', pos: 'adj.', zh: '宝贵的；有价值的', deck: 'junior', ex: 'Failure can teach us valuable lessons about life.', exZh: '失败能给我们上宝贵的一课。' },

  { w: 'abandon', p: '/əˈbændən/', pos: 'v.', zh: '放弃；抛弃', deck: 'senior', ex: 'He never abandoned his dream of becoming a pilot.', exZh: '他从未放弃当飞行员的梦想。' },
  { w: 'appreciate', p: '/əˈpriːʃieɪt/', pos: 'v.', zh: '感激；欣赏', deck: 'senior', ex: 'I really appreciate your help with my college application.', exZh: '你帮了我大学申请的忙，真的很感激。' },
  { w: 'approach', p: '/əˈproʊtʃ/', pos: 'n. / v.', zh: '方法；接近', deck: 'senior', ex: 'Her careful approach to problems impressed the interviewers.', exZh: '她处理问题的方式细致周到，让面试官印象深刻。' },
  { w: 'available', p: '/əˈveɪləbl/', pos: 'adj.', zh: '可获得的；有空的', deck: 'senior', ex: 'The library is available to all students after class.', exZh: '课后图书馆向全体学生开放。' },
  { w: 'concentrate', p: '/ˈkɑːnsntreɪt/', pos: 'v.', zh: '集中注意力；专心', deck: 'senior', ex: 'I cannot concentrate on my homework when the TV is on.', exZh: '电视开着的时候，我无法专心做作业。' },
  { w: 'contribute', p: '/kənˈtrɪbjuːt/', pos: 'v.', zh: '贡献；捐献；促成', deck: 'senior', ex: 'Everyone can contribute ideas to the class project.', exZh: '班级项目上，每个人都能出主意。' },
  { w: 'emphasize', p: '/ˈemfəsaɪz/', pos: 'v.', zh: '强调', deck: 'senior', ex: 'The headmaster emphasized the importance of teamwork in his speech.', exZh: '校长在讲话中强调了团队合作的重要性。' },
  { w: 'establish', p: '/ɪˈstæblɪʃ/', pos: 'v.', zh: '建立；确立', deck: 'senior', ex: 'The university established a new lab for AI research.', exZh: '这所大学新建了一个人工智能研究实验室。' },
  { w: 'impact', p: '/ˈɪmpækt/', pos: 'n. / v.', zh: '影响；冲击', deck: 'senior', ex: 'Mobile phones have a huge impact on teenage life.', exZh: '手机对青少年的生活影响巨大。' },
  { w: 'individual', p: '/ˌɪndɪˈvɪdʒuəl/', pos: 'n. / adj.', zh: '个人；单独的', deck: 'senior', ex: 'Each individual has a role to play in the team.', exZh: '团队中每个人都有自己的角色。' },
  { w: 'persuade', p: '/pərˈsweɪd/', pos: 'v.', zh: '说服；使相信', deck: 'senior', ex: 'She persuaded her parents to let her study abroad.', exZh: '她说服父母同意她出国留学。' },
  { w: 'potential', p: '/pəˈtenʃl/', pos: 'n. / adj.', zh: '潜力；潜在的', deck: 'senior', ex: 'This training program helps young players realize their potential.', exZh: '这个培训项目帮助年轻球员发挥潜力。' },
  { w: 'significant', p: '/sɪɡˈnɪfɪkənt/', pos: 'adj.', zh: '重要的；显著的', deck: 'senior', ex: 'There has been a significant increase in online learning.', exZh: '在线学习人数出现了显著增长。' },
  { w: 'tackle', p: '/ˈtækl/', pos: 'v.', zh: '处理；解决', deck: 'senior', ex: 'The government is taking action to tackle air pollution.', exZh: '政府正在采取行动治理空气污染。' },
  { w: 'absorb', p: '/əbˈzɔːrb/', pos: 'v.', zh: '吸收；理解', deck: 'senior', ex: 'Plants absorb sunlight to make food for themselves.', exZh: '植物吸收阳光，为自己制造养分。' },
  { w: 'acknowledge', p: '/əkˈnɑːlɪdʒ/', pos: 'v.', zh: '承认；致谢', deck: 'senior', ex: 'He acknowledged that his carelessness caused the accident.', exZh: '他承认是自己粗心造成了事故。' },
  { w: 'adapt', p: '/əˈdæpt/', pos: 'v.', zh: '适应；改编', deck: 'senior', ex: 'Exchange students need time to adapt to local customs.', exZh: '交换生需要时间适应当地风俗。' },
  { w: 'adopt', p: '/əˈdɑːpt/', pos: 'v.', zh: '采用；收养', deck: 'senior', ex: 'The school adopted new methods to improve physical education.', exZh: '学校采用了新方法改进体育课。' },
  { w: 'advocate', p: '/ˈædvəkeɪt/', pos: 'v. / n.', zh: '提倡；拥护者', deck: 'senior', ex: 'Many doctors advocate a balanced diet and regular exercise.', exZh: '许多医生提倡均衡饮食、规律锻炼。' },
  { w: 'ambitious', p: '/æmˈbɪʃəs/', pos: 'adj.', zh: '有抱负的；雄心勃勃的', deck: 'senior', ex: 'She is ambitious and dreams of running her own company.', exZh: '她志向远大，梦想拥有自己的公司。' },
  { w: 'analyze', p: '/ˈænəlaɪz/', pos: 'v.', zh: '分析', deck: 'senior', ex: 'Scientists analyzed the data collected from the space station.', exZh: '科学家分析了从空间站采集的数据。' },
  { w: 'announce', p: '/əˈnaʊns/', pos: 'v.', zh: '宣布；通知', deck: 'senior', ex: 'The school announced the dates of the sports meeting.', exZh: '学校公布了运动会的举办日期。' },
  { w: 'application', p: '/ˌæplɪˈkeɪʃn/', pos: 'n.', zh: '申请；应用', deck: 'senior', ex: 'The application of AI technology is changing our daily lives.', exZh: '人工智能技术的应用正在改变我们的日常生活。' },
  { w: 'assume', p: '/əˈsuːm/', pos: 'v.', zh: '假定；想当然认为', deck: 'senior', ex: 'Never assume that others think exactly the way you do.', exZh: '别想当然地以为别人和你的想法完全一样。' },
  { w: 'attempt', p: '/əˈtempt/', pos: 'n. / v.', zh: '尝试；努力', deck: 'senior', ex: 'His first attempt at the high jump ended in failure.', exZh: '他第一次尝试跳高以失败告终。' },
  { w: 'authority', p: '/əˈθɔːrəti/', pos: 'n.', zh: '当局；权威', deck: 'senior', ex: 'The local authorities are planning a new subway line.', exZh: '当地政府正在规划一条新的地铁线路。' },
  { w: 'benefit', p: '/ˈbenɪfɪt/', pos: 'n. / v.', zh: '好处；有益于', deck: 'senior', ex: 'Doing regular exercise benefits both your body and mind.', exZh: '经常锻炼对身体和心态都有好处。' },
  { w: 'campaign', p: '/kæmˈpeɪn/', pos: 'n. / v.', zh: '运动；宣传活动', deck: 'senior', ex: 'The city launched a campaign to encourage garbage sorting.', exZh: '这座城市发起了一项鼓励垃圾分类的活动。' },
  { w: 'candidate', p: '/ˈkændɪdət/', pos: 'n.', zh: '候选人；考生', deck: 'senior', ex: 'Each candidate must finish the speaking test in ten minutes.', exZh: '每位考生须在十分钟内完成口语测试。' },
  { w: 'circumstance', p: '/ˈsɜːrkəmstæns/', pos: 'n.', zh: '情况；环境', deck: 'senior', ex: 'Under no circumstances should we give up halfway.', exZh: '任何情况下我们都不该半途而废。' },
  { w: 'commitment', p: '/kəˈmɪtmənt/', pos: 'n.', zh: '承诺；投入', deck: 'senior', ex: 'Winning the championship takes talent and real commitment.', exZh: '摘得冠军需要天赋，更需要全身心的投入。' },
  { w: 'competition', p: '/ˌkɑːmpəˈtɪʃn/', pos: 'n.', zh: '比赛；竞争', deck: 'senior', ex: 'Facing fierce competition, the young team stayed calm.', exZh: '面对激烈的竞争，这支年轻队伍保持沉着。' },
  { w: 'confident', p: '/ˈkɑːnfɪdənt/', pos: 'adj.', zh: '自信的；确信的', deck: 'senior', ex: 'Practice in front of a mirror makes speakers more confident.', exZh: '对着镜子练习能让演讲的人更自信。' },
  { w: 'conflict', p: '/ˈkɑːnflɪkt/', pos: 'n. / v.', zh: '冲突；矛盾', deck: 'senior', ex: 'Honest communication can solve most conflicts between friends.', exZh: '坦诚的沟通能化解朋友间的大部分矛盾。' },
  { w: 'confuse', p: '/kənˈfjuːz/', pos: 'v.', zh: '使困惑；混淆', deck: 'senior', ex: 'Students often confuse these two similar English words.', exZh: '学生们常常混淆这两个相近的英语单词。' },
  { w: 'considerate', p: '/kənˈsɪdərət/', pos: 'adj.', zh: '体贴的；考虑周到的', deck: 'senior', ex: 'It was considerate of him to bring us umbrellas.', exZh: '他很体贴，还特意给我们带了伞。' },
  { w: 'convince', p: '/kənˈvɪns/', pos: 'v.', zh: '使确信；说服', deck: 'senior', ex: 'The evidence convinced the jury of his innocence.', exZh: '证据让陪审团确信他是清白的。' },
  { w: 'demand', p: '/dɪˈmænd/', pos: 'v. / n.', zh: '要求；需求', deck: 'senior', ex: 'The demand for electric cars keeps growing worldwide.', exZh: '全球对电动汽车的需求不断增长。' },
  { w: 'deserve', p: '/dɪˈzɜːrv/', pos: 'v.', zh: '值得；应得', deck: 'senior', ex: 'Teams that train hard deserve to win the trophy.', exZh: '刻苦训练的队伍理应捧起奖杯。' },
  { w: 'determine', p: '/dɪˈtɜːrmɪn/', pos: 'v.', zh: '决定；下定决心', deck: 'senior', ex: 'Hard work and luck both determine the final result.', exZh: '努力与运气共同决定最终的结果。' },
  { w: 'efficient', p: '/ɪˈfɪʃnt/', pos: 'adj.', zh: '高效的', deck: 'senior', ex: 'The new high-speed rail makes travel faster and more efficient.', exZh: '新高铁让出行更快、更高效。' },
  { w: 'expand', p: '/ɪkˈspænd/', pos: 'v.', zh: '扩大；扩展', deck: 'senior', ex: 'The company plans to expand its business to Europe.', exZh: '这家公司计划把业务拓展到欧洲。' },
  { w: 'figure', p: '/ˈfɪɡjər/', pos: 'n. / v.', zh: '数字；人物；弄清', deck: 'senior', ex: 'I cannot figure out why the machine stopped suddenly.', exZh: '我搞不懂那台机器为什么突然停了。' },
  { w: 'flexible', p: '/ˈfleksəbl/', pos: 'adj.', zh: '灵活的；柔韧的', deck: 'senior', ex: 'Flexible working hours help employees balance work and family.', exZh: '弹性的工作时间帮助员工平衡工作与家庭。' },
  { w: 'guarantee', p: '/ˌɡærənˈtiː/', pos: 'v. / n.', zh: '保证；担保', deck: 'senior', ex: 'Practice does not guarantee perfection, but it always helps.', exZh: '练习未必保证完美，但总有帮助。' },
  { w: 'ignore', p: '/ɪɡˈnɔːr/', pos: 'v.', zh: '忽视；不理会', deck: 'senior', ex: 'Do not ignore small mistakes in your writing.', exZh: '不要忽视写作中的小错误。' },
  { w: 'impress', p: '/ɪmˈpres/', pos: 'v.', zh: '使印象深刻', deck: 'senior', ex: 'Her fluent English impressed everyone at the interview.', exZh: '她流利的英语让面试官们印象深刻。' },
  { w: 'inspire', p: '/ɪnˈspaɪər/', pos: 'v.', zh: '激励；启发', deck: 'senior', ex: 'Great teachers inspire students to think for themselves.', exZh: '优秀的老师启发学生独立思考。' },
  { w: 'intend', p: '/ɪnˈtend/', pos: 'v.', zh: '打算；想要', deck: 'senior', ex: 'We intend to plant one hundred trees this spring.', exZh: '我们打算今年春天种下一百棵树。' },
  { w: 'mission', p: '/ˈmɪʃn/', pos: 'n.', zh: '使命；任务', deck: 'senior', ex: 'The crew completed their mission and returned safely.', exZh: '机组人员完成任务后安全返回。' },
  { w: 'observe', p: '/əbˈzɜːrv/', pos: 'v.', zh: '观察；遵守', deck: 'senior', ex: 'Students observed the moon through telescopes last night.', exZh: '昨晚学生们用望远镜观测月亮。' },
  { w: 'overcome', p: '/ˌoʊvərˈkʌm/', pos: 'v.', zh: '克服；战胜', deck: 'senior', ex: 'She overcame her fear of public speaking through repeated practice.', exZh: '通过反复练习，她克服了当众发言的恐惧。' },
  { w: 'priority', p: '/praɪˈɔːrəti/', pos: 'n.', zh: '优先事项', deck: 'senior', ex: 'Health should be a top priority for busy students.', exZh: '对学业繁忙的学生而言，健康应当放在首位。' },
  { w: 'remarkable', p: '/rɪˈmɑːrkəbl/', pos: 'adj.', zh: '非凡的；显著的', deck: 'senior', ex: 'The old professor made remarkable discoveries in rice science.', exZh: '这位老教授在水稻研究上取得了非凡的发现。' },
  { w: 'resource', p: '/ˈriːsɔːrs/', pos: 'n.', zh: '资源', deck: 'senior', ex: 'The internet provides rich learning resources for free.', exZh: '互联网免费提供了丰富的学习资源。' },
  { w: 'strategy', p: '/ˈstrætədʒi/', pos: 'n.', zh: '策略；战略', deck: 'senior', ex: 'A good reading strategy saves time in the exam.', exZh: '好的阅读策略能在考试中省下时间。' },
  { w: 'submit', p: '/səbˈmɪt/', pos: 'v.', zh: '提交；呈递', deck: 'senior', ex: 'Please submit your application form before Friday noon.', exZh: '请在周五中午前提交申请表。' },
  { w: 'tend', p: '/tend/', pos: 'v.', zh: '往往会；趋向', deck: 'senior', ex: 'People tend to work better in quiet places.', exZh: '在安静的环境里，人们往往干得更好。' },
  { w: 'theory', p: '/ˈθɪri/', pos: 'n.', zh: '理论；学说', deck: 'senior', ex: 'The theory of evolution changed how we see life.', exZh: '进化论改变了我们看待生命的方式。' },
  { w: 'transform', p: '/trænsˈfɔːrm/', pos: 'v.', zh: '使改观；转变', deck: 'senior', ex: 'Technology has transformed the way students learn English.', exZh: '科技改变了学生学习英语的方式。' },

        examples: [
          { en: 'There will be a football match between Class One and Class Two next Friday.', zh: '下周五一班和二班之间将有一场足球赛。' },
          { en: 'There is going to be a parents’ meeting this evening.', zh: '今晚要开一次家长会。' },
        ],

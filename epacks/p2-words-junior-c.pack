  { w: 'term', p: '/tɜːrm/', pos: 'n.', zh: '学期；任期', deck: 'junior', ex: 'Our school holds two big exams every term.', exZh: '我们学校每学期举行两次大考。' },
  { w: 'project', p: '/ˈprɑːdʒekt/', pos: 'n.', zh: '课题；项目；方案', deck: 'junior', ex: 'Our science group is making a project about protecting rivers.', exZh: '我们的科学小组正在做一个关于保护河流的课题。' },
  { w: 'notice', p: '/ˈnoʊtɪs/', pos: 'n. / v.', zh: '通知；布告；注意到', deck: 'junior', ex: 'There is a notice about the school trip on the board.', exZh: '布告栏里贴着一张关于学校出游的通知。' },
  { w: 'monitor', p: '/ˈmɑːnɪtər/', pos: 'n.', zh: '班长；显示器', deck: 'junior', ex: 'As monitor, he hands in our homework every morning.', exZh: '作为班长，他每天早上收我们的作业。' },
  { w: 'duty', p: '/ˈduːti/', pos: 'n.', zh: '责任；职责；值日', deck: 'junior', ex: 'It is my duty to water the plants in our classroom this week.', exZh: '这周给教室里的植物浇水是我的职责。' },
  { w: 'report', p: '/rɪˈpɔːrt/', pos: 'n. / v.', zh: '报告；汇报；成绩单', deck: 'junior', ex: 'My school report shows my progress in every subject.', exZh: '我的成绩单显示了我在每一门科目上的进步。' },
  { w: 'spell', p: '/spel/', pos: 'v.', zh: '拼写；用字母拼', deck: 'junior', ex: 'Can you spell your full name in English, please?', exZh: '请你用英语拼一下自己的全名。' },
  { w: 'education', p: '/ˌedʒuˈkeɪʃn/', pos: 'n.', zh: '教育；培养', deck: 'junior', ex: 'A good education opens doors to a better future.', exZh: '良好的教育会打开通往更好未来的大门。' },
  { w: 'race', p: '/reɪs/', pos: 'n.', zh: '赛跑；速度竞赛', deck: 'junior', ex: 'He trained hard every day and finally won the school race.', exZh: '他每天刻苦训练，最终赢得了学校的赛跑比赛。' },
  { w: 'win', p: '/wɪn/', pos: 'v.', zh: '获胜；赢得；赢', deck: 'junior', ex: 'If we keep practicing, we will win the match next week.', exZh: '如果我们坚持练习，下周的比赛我们会赢。' },

  { w: 'mood', p: '/muːd/', pos: 'n.', zh: '心情；情绪', deck: 'junior', ex: 'A short walk after lunch always lifts my mood.', exZh: '午饭后散步片刻总能让我心情变好。' },
  { w: 'shy', p: '/ʃaɪ/', pos: 'adj.', zh: '害羞的；腼腆的', deck: 'junior', ex: 'The shy boy answered in a low voice, but everyone heard him.', exZh: '那个害羞的男孩回答时声音很低，但大家都听到了。' },
  { w: 'worry', p: '/ˈwɜːri/', pos: 'v. / n.', zh: '担心；发愁；忧虑', deck: 'junior', ex: 'Do not worry too much about one small test.', exZh: '不必为一次小测验担心太多。' },
  { w: 'confidence', p: '/ˈkɑːnfɪdəns/', pos: 'n.', zh: '信心；自信', deck: 'junior', ex: 'Reading English aloud every morning gave her more confidence.', exZh: '每天早上大声读英语让她更有自信。' },
  { w: 'patience', p: '/ˈpeɪʃns/', pos: 'n.', zh: '耐心；忍耐', deck: 'junior', ex: 'Teaching my little brother to swim takes a lot of patience.', exZh: '教弟弟学游泳需要很多耐心。' },
  { w: 'kindness', p: '/ˈkaɪndnəs/', pos: 'n.', zh: '善良；好意', deck: 'junior', ex: 'Small acts of kindness can make a big difference.', exZh: '小小的善举能带来很大的改变。' },
  { w: 'pride', p: '/praɪd/', pos: 'n.', zh: '自豪；骄傲', deck: 'junior', ex: 'She looked at her picture with pride before handing it in.', exZh: '交作业前，她满怀自豪地看了看自己的画。' },
  { w: 'shame', p: '/ʃeɪm/', pos: 'n.', zh: '羞愧；憾事', deck: 'junior', ex: 'He felt shame after lying to his best friend.', exZh: '向最好的朋友撒谎之后，他感到很羞愧。' },
  { w: 'regret', p: '/rɪˈɡret/', pos: 'v. / n.', zh: '后悔；遗憾', deck: 'junior', ex: 'I regret spending so much time on phone games last term.', exZh: '我后悔上学期在手机游戏上花了太多时间。' },
  { w: 'rude', p: '/ruːd/', pos: 'adj.', zh: '粗鲁的；无礼的', deck: 'junior', ex: 'It is rude to point at people with your finger.', exZh: '用手指指人是很不礼貌的。' },
  { w: 'lazy', p: '/ˈleɪzi/', pos: 'adj.', zh: '懒惰的；懒散的', deck: 'junior', ex: 'He was too lazy to pack his school bag last night.', exZh: '他昨晚太懒了，连书包都没收拾。' },
  { w: 'attitude', p: '/ˈætɪtuːd/', pos: 'n.', zh: '态度；看法', deck: 'junior', ex: 'A positive attitude helps you do better in every subject.', exZh: '积极的态度能让你在每门学科上都做得更好。' },

  { w: 'dangerous', p: '/ˈdeɪndʒərəs/', pos: 'adj.', zh: '危险的；不安全的', deck: 'junior', ex: 'It is dangerous to swim in the river alone in summer.', exZh: '夏天独自下河游泳很危险。' },
  { w: 'safety', p: '/ˈseɪfti/', pos: 'n.', zh: '安全；平安', deck: 'junior', ex: 'Our teacher gave us a talk about safety before the school trip.', exZh: '学校出游前，老师给我们讲了一堂安全知识课。' },
  { w: 'accident', p: '/ˈæksɪdənt/', pos: 'n.', zh: '事故；意外', deck: 'junior', ex: 'The driver stopped quickly, so no one was hurt in the accident.', exZh: '那位司机及时停车，事故中没有人受伤。' },
  { w: 'stomachache', p: '/ˈstʌməkeɪk/', pos: 'n.', zh: '胃痛；肚子痛', deck: 'junior', ex: 'He ate too much ice cream and got a stomachache at night.', exZh: '他吃了太多冰淇淋，晚上胃疼了起来。' },
  { w: 'tired', p: '/ˈtaɪərd/', pos: 'adj.', zh: '疲劳的；疲倦的', deck: 'junior', ex: 'After a whole morning of cleaning, everyone felt tired but happy.', exZh: '打扫了一上午之后，大家都累但很开心。' },
  { w: 'hungry', p: '/ˈhʌŋɡri/', pos: 'adj.', zh: '饥饿的；感到饿的', deck: 'junior', ex: 'I always feel hungry by the last class of the day.', exZh: '到每天最后一节课时，我总会觉得饿。' },
  { w: 'thirsty', p: '/ˈθɜːrsti/', pos: 'adj.', zh: '口渴的；缺水的', deck: 'junior', ex: 'Bring a bottle of water, or you will feel thirsty after the run.', exZh: '带上瓶水吧，不然跑完步你会口渴的。' },
  { w: 'alarm', p: '/əˈlɑːrm/', pos: 'n.', zh: '警报；警报器；闹钟', deck: 'junior', ex: 'The fire alarm rang, and we left the building quickly.', exZh: '火警警报响了，我们迅速离开了教学楼。' },
  { w: 'exit', p: '/ˈeksɪt/', pos: 'n.', zh: '出口；安全出口', deck: 'junior', ex: 'The green signs show the way to the nearest exit.', exZh: '绿色标识指示着最近出口的方向。' },
  { w: 'escape', p: '/ɪˈskeɪp/', pos: 'v.', zh: '逃跑；逃离；逃脱', deck: 'junior', ex: 'Fire drills teach us how to escape from a burning building.', exZh: '消防演练教我们如何从着火的楼里安全逃生。' },
  { w: 'cross', p: '/krɔːs/', pos: 'v.', zh: '穿过；横过；越过', deck: 'junior', ex: 'Never cross the road when the light is red.', exZh: '红灯亮着时，千万不要横穿马路。' },
  { w: 'stranger', p: '/ˈstreɪndʒər/', pos: 'n.', zh: '陌生人；生人', deck: 'junior', ex: 'Do not open the door for a stranger when you are home alone.', exZh: '独自在家时，不要给陌生人开门。' },

  { w: 'nature', p: '/ˈneɪtʃər/', pos: 'n.', zh: '大自然；自然界', deck: 'junior', ex: 'Many city children know little about plants and nature.', exZh: '许多城市孩子对植物和自然了解很少。' },
  { w: 'planet', p: '/ˈplænɪt/', pos: 'n.', zh: '行星；地球', deck: 'junior', ex: 'Recycling paper and plastic helps protect our planet.', exZh: '回收纸张和塑料有助于保护我们的地球。' },
  { w: 'ocean', p: '/ˈoʊʃn/', pos: 'n.', zh: '海洋；大海', deck: 'junior', ex: 'Whales are the largest animals in the ocean.', exZh: '鲸是海洋里最大的动物。' },
  { w: 'wild', p: '/waɪld/', pos: 'adj.', zh: '野生的；荒野的', deck: 'junior', ex: 'We watched wild birds by the lake last Sunday.', exZh: '上周日我们在湖边观察野生鸟类。' },
  { w: 'panda', p: '/ˈpændə/', pos: 'n.', zh: '熊猫；大熊猫', deck: 'junior', ex: 'The panda eats bamboo for more than ten hours a day.', exZh: '熊猫每天要吃十多个小时的竹子。' },
  { w: 'insect', p: '/ˈɪnsekt/', pos: 'n.', zh: '昆虫；虫子', deck: 'junior', ex: 'An insect has six legs, but a spider has eight.', exZh: '昆虫有六条腿，而蜘蛛有八条。' },
  { w: 'leaf', p: '/liːf/', pos: 'n.', zh: '叶；叶子', deck: 'junior', ex: 'A yellow leaf fell from the tree onto my book.', exZh: '一片黄叶从树上落下来，掉在我的书上。' },
  { w: 'seed', p: '/siːd/', pos: 'n.', zh: '种子；籽', deck: 'junior', ex: 'Each little seed can grow into a tall sunflower.', exZh: '每一粒小种子都能长成高高的向日葵。' },
  { w: 'electricity', p: '/ɪˌlekˈtrɪsəti/', pos: 'n.', zh: '电；电流', deck: 'junior', ex: 'Turn off the lights when you leave, and you will save electricity.', exZh: '离开时随手关灯，你就能节约用电。' },
  { w: 'factory', p: '/ˈfæktri/', pos: 'n.', zh: '工厂；制造厂', deck: 'junior', ex: 'Dirty water from the factory made the fish in the river die.', exZh: '工厂排出的污水让河里的鱼死掉了。' },

  { w: 'doctor', p: '/ˈdɑːktər/', pos: 'n.', zh: '医生；大夫', deck: 'junior', ex: 'You should see a doctor if the cough lasts more than a week.', exZh: '如果咳嗽超过一周，你就应该去看医生。' },
  { w: 'engineer', p: '/ˌendʒɪˈnɪr/', pos: 'n.', zh: '工程师；技师', deck: 'junior', ex: 'My uncle is an engineer who builds long bridges over rivers.', exZh: '我叔叔是一名在河流上修建长桥的工程师。' },
  { w: 'pilot', p: '/ˈpaɪlət/', pos: 'n.', zh: '飞行员；领航员', deck: 'junior', ex: 'The pilot thanked the passengers for staying calm.', exZh: '飞行员感谢乘客们保持冷静。' },
  { w: 'scientist', p: '/ˈsaɪəntɪst/', pos: 'n.', zh: '科学家；科研人员', deck: 'junior', ex: 'The scientist spent years studying rice in the fields.', exZh: '那位科学家常年在田里研究水稻。' },
  { w: 'farmer', p: '/ˈfɑːrmər/', pos: 'n.', zh: '农民；农场主', deck: 'junior', ex: 'The farmer wakes up early to feed the animals on his farm.', exZh: '农民一早就起床，去喂农场里的动物。' },
  { w: 'manager', p: '/ˈmænɪdʒər/', pos: 'n.', zh: '经理；管理人', deck: 'junior', ex: 'She hopes to be a hotel manager after leaving school.', exZh: '她想毕业后当一名酒店经理。' },
  { w: 'waiter', p: '/ˈweɪtər/', pos: 'n.', zh: '服务员；侍者', deck: 'junior', ex: 'The waiter brought us the menu with a smile.', exZh: '服务员微笑着给我们拿来了菜单。' },
  { w: 'musician', p: '/mjuˈzɪʃn/', pos: 'n.', zh: '音乐家；乐手', deck: 'junior', ex: 'The musician wrote this song for his hometown.', exZh: '这位音乐家为家乡写了这首歌。' },
  { w: 'dream', p: '/driːm/', pos: 'n. / v.', zh: '梦想；梦；理想', deck: 'junior', ex: 'Work hard from now on, and your dream will come true.', exZh: '从现在起努力，你的梦想终会实现。' },
  { w: 'future', p: '/ˈfjuːtʃər/', pos: 'n.', zh: '未来；将来；前途', deck: 'junior', ex: 'Learning English well will help you a lot in the future.', exZh: '学好英语会对你的将来大有帮助。' },
  { w: 'success', p: '/səkˈses/', pos: 'n.', zh: '成功；成就', deck: 'junior', ex: 'Small daily efforts lead to success in the end.', exZh: '每天一点一滴的努力，最终会带来成功。' },

  { w: 'hobby', p: '/ˈhɑːbi/', pos: 'n.', zh: '爱好；业余爱好', deck: 'junior', ex: 'Collecting stamps is a hobby that costs little money.', exZh: '集邮是一种花费不多的爱好。' },
  { w: 'piano', p: '/piˈænoʊ/', pos: 'n.', zh: '钢琴', deck: 'junior', ex: 'She practices the piano for thirty minutes after homework.', exZh: '她每天写完作业后练三十分钟钢琴。' },
  { w: 'diary', p: '/ˈdaɪəri/', pos: 'n.', zh: '日记；日记本', deck: 'junior', ex: 'I keep an English diary to remember each happy day.', exZh: '我坚持写英文日记，记录每个快乐的日子。' },
  { w: 'holiday', p: '/ˈhɑːlədeɪ/', pos: 'n.', zh: '假日；假期', deck: 'junior', ex: 'We will visit my grandparents during the winter holiday.', exZh: '寒假期间我们要去看望爷爷奶奶。' },
  { w: 'pet', p: '/pet/', pos: 'n.', zh: '宠物；爱畜', deck: 'junior', ex: 'My pet dog waits for me at the gate every afternoon.', exZh: '我的宠物狗每天下午都在门口等我。' },

  { w: 'commit', p: '/kəˈmɪt/', pos: 'v.', zh: '犯（罪、错）；承诺；致力于', deck: 'exam', ex: 'He committed himself to practicing the piano daily.', exZh: '他下定决心，每天坚持练琴。' },
  { w: 'confront', p: '/kənˈfrʌnt/', pos: 'v.', zh: '面对；正视', deck: 'exam', ex: 'She had to confront her fear of public speaking.', exZh: '她必须直面自己对当众讲话的恐惧。' },
  { w: 'controversy', p: '/ˈkɑːntrəvɜːrsi/', pos: 'n.', zh: '争议；公开争论', deck: 'exam', ex: 'The new exam policy caused much controversy among parents.', exZh: '新的考试政策在家长中引起了不小的争议。' },
  { w: 'deliberate', p: '/dɪˈlɪbərət/', pos: 'adj. / v.', zh: '故意的；慎重考虑', deck: 'exam', ex: 'It was a deliberate choice, not an accident.', exZh: '这是深思熟虑的选择，并非偶然。' },
  { w: 'deteriorate', p: '/dɪˈtɪriəreɪt/', pos: 'v.', zh: '恶化；变坏', deck: 'exam', ex: 'His eyesight began to deteriorate after long gaming nights.', exZh: '连着几晚熬夜打游戏后，他的视力开始变差。' },
  { w: 'diminish', p: '/dɪˈmɪnɪʃ/', pos: 'v.', zh: '减少；削弱', deck: 'exam', ex: 'Nothing could diminish her love for the old piano.', exZh: '什么也无法减少她对那架旧钢琴的热爱。' },
  { w: 'diverse', p: '/daɪˈvɜːrs/', pos: 'adj.', zh: '多种多样的；不同的', deck: 'exam', ex: 'Our class includes students from diverse cultural backgrounds.', exZh: '我们班的学生来自不同的文化背景。' },
  { w: 'eliminate', p: '/ɪˈlɪmɪneɪt/', pos: 'v.', zh: '消除；淘汰', deck: 'exam', ex: 'The team was eliminated in the first round again.', exZh: '这支队伍又在第一轮就被淘汰了。' },
  { w: 'estimate', p: '/ˈestɪmeɪt/', pos: 'v. / n.', zh: '估计；估算', deck: 'exam', ex: 'Engineers estimate the bridge will take two years.', exZh: '工程师估计这座桥需要两年建成。' },
  { w: 'expand', p: '/ɪkˈspænd/', pos: 'v.', zh: '扩大；扩展', deck: 'exam', ex: 'The club plans to expand its activities this year.', exZh: '社团打算今年拓展活动内容。' },
  { w: 'facilitate', p: '/fəˈsɪlɪteɪt/', pos: 'v.', zh: '促进；使便利', deck: 'exam', ex: 'The new app facilitates communication between teachers and parents.', exZh: '新应用让老师和家长的沟通更顺畅。' },
  { w: 'fundamental', p: '/ˌfʌndəˈmentl/', pos: 'adj.', zh: '基本的；根本的', deck: 'exam', ex: 'Reading is a fundamental skill for every other subject.', exZh: '阅读是学好其他每一门课的基本功。' },
  { w: 'generate', p: '/ˈdʒenəreɪt/', pos: 'v.', zh: '产生；引起', deck: 'exam', ex: 'Wind turbines generate clean electricity for the whole town.', exZh: '风力发电机为全镇提供清洁电力。' },
  { w: 'implement', p: '/ˈɪmplɪment/', pos: 'v.', zh: '实施；执行', deck: 'exam', ex: 'The city will implement the recycling plan next month.', exZh: '该市将从下个月起实施回收计划。' },
  { w: 'initiative', p: '/ɪˈnɪʃətɪv/', pos: 'n.', zh: '倡议；主动性', deck: 'exam', ex: 'She showed real initiative by organizing the book drive.', exZh: '她主动组织捐书活动，展现出很强的主动性。' },
  { w: 'innovation', p: '/ˌɪnəˈveɪʃn/', pos: 'n.', zh: '创新；革新', deck: 'exam', ex: 'The science fair rewards innovation more than perfect results.', exZh: '科学展更看重创新，而不是完美的结果。' },
  { w: 'insight', p: '/ˈɪnsaɪt/', pos: 'n.', zh: '洞察力；深刻见解', deck: 'exam', ex: "The interview gave me insight into the writer's life.", exZh: '这次访谈让我深入了解了那位作家的人生。' },
  { w: 'integrity', p: '/ɪnˈteɡrəti/', pos: 'n.', zh: '正直；诚实', deck: 'exam', ex: 'A referee must judge every match with integrity.', exZh: '裁判执裁每一场比赛都必须公正诚实。' },
  { w: 'interfere', p: '/ˌɪntərˈfɪr/', pos: 'v.', zh: '干涉；妨碍', deck: 'exam', ex: 'Please do not interfere with the lab equipment.', exZh: '请不要乱动实验室的设备。' },
  { w: 'justify', p: '/ˈdʒʌstɪfaɪ/', pos: 'v.', zh: '为…辩护；证明…正当', deck: 'exam', ex: 'Long practice hours do not justify ignoring your health.', exZh: '练习时间长，也不能成为忽视健康的理由。' },
  { w: 'launch', p: '/lɔːntʃ/', pos: 'v. / n.', zh: '发起；推出；发射', deck: 'exam', ex: 'The city launched a campaign to clean the river.', exZh: '该市发起了一场治理河流的活动。' },
  { w: 'legislation', p: '/ˌledʒɪsˈleɪʃn/', pos: 'n.', zh: '法律；立法', deck: 'exam', ex: 'New legislation bans smoking near schools and hospitals.', exZh: '新法律规定学校和医院附近禁止吸烟。' },
  { w: 'overcome', p: '/ˌoʊvərˈkʌm/', pos: 'v.', zh: '克服；战胜', deck: 'exam', ex: 'With practice, you can overcome your fear of exams.', exZh: '只要勤加练习，你就能克服考试恐惧。' },

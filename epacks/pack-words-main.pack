  { w: 'ambitious', p: '/æmˈbɪʃəs/', pos: 'adj.', zh: '有雄心的；志向远大的', deck: 'exam', ex: 'She is ambitious and dreams of studying medicine abroad.', exZh: '她志向远大，梦想出国学医。' },

  { w: 'poverty', p: '/ˈpɑːvərti/', pos: 'n.', zh: '贫穷；贫困', deck: 'exam', ex: 'The charity helps children whose families live in poverty.', exZh: '这家慈善机构帮助那些家庭贫困的孩子。' },
  { w: 'priority', p: '/praɪˈɔːrəti/', pos: 'n.', zh: '优先事项', deck: 'exam', ex: 'Safety is always the first priority on school trips.', exZh: '学校组织出游时，安全永远是第一位的。' },
  { w: 'pursue', p: '/pərˈsuː/', pos: 'v.', zh: '追求；从事', deck: 'exam', ex: 'He decided to pursue his dream of becoming a pilot.', exZh: '他决定追求自己当飞行员的梦想。' },
  { w: 'reflect', p: '/rɪˈflekt/', pos: 'v.', zh: '反思；反映', deck: 'exam', ex: 'Good grades reflect months of quiet, steady effort.', exZh: '好成绩反映出几个月来踏实稳定的努力。' },
  { w: 'regulate', p: '/ˈreɡjuleɪt/', pos: 'v.', zh: '管理；调节', deck: 'exam', ex: 'New rules regulate how food trucks operate downtown.', exZh: '新规定规范了市区餐车的经营方式。' },
  { w: 'reveal', p: '/rɪˈviːl/', pos: 'v.', zh: '揭示；透露', deck: 'exam', ex: 'The survey revealed that most students sleep too little.', exZh: '调查显示，大多数学生睡眠不足。' },
  { w: 'sacrifice', p: '/ˈsækrɪfaɪs/', pos: 'v. / n.', zh: '牺牲；舍弃', deck: 'exam', ex: 'Parents often sacrifice their own comfort for their children.', exZh: '父母常常为了孩子牺牲自己的安逸。' },
  { w: 'strategy', p: '/ˈstrætədʒi/', pos: 'n.', zh: '策略；战略', deck: 'exam', ex: "Our team's winning strategy was simple passing and speed.", exZh: '我们队的制胜策略就是简洁的传接和速度。' },
  { w: 'substitute', p: '/ˈsʌbstɪtuːt/', pos: 'v. / n.', zh: '代替；代替者', deck: 'exam', ex: 'You can substitute honey for sugar in this recipe.', exZh: '这份食谱里可以用蜂蜜代替白糖。' },
  { w: 'sustainable', p: '/səˈsteɪnəbl/', pos: 'adj.', zh: '可持续的', deck: 'exam', ex: 'The town built a sustainable farm run by students.', exZh: '镇上建起了一个由学生经营的可持续农场。' },
  { w: 'transform', p: '/trænsˈfɔːrm/', pos: 'v.', zh: '使改观；转变', deck: 'exam', ex: 'A fresh coat of paint transformed the old classroom.', exZh: '重新粉刷之后，旧教室焕然一新。' },
  { w: 'urban', p: '/ˈɜːrbən/', pos: 'adj.', zh: '城市的', deck: 'exam', ex: 'Urban parks give city children space to play.', exZh: '城市公园给城里的孩子提供了玩耍的空间。' },
  { w: 'virtual', p: '/ˈvɜːrtʃuəl/', pos: 'adj.', zh: '虚拟的', deck: 'exam', ex: 'The museum offers a virtual tour for school classes.', exZh: '这家博物馆为学校班级提供虚拟参观。' },
  { w: 'welfare', p: '/ˈwelfer/', pos: 'n.', zh: '福利；福祉', deck: 'exam', ex: 'The government works to improve the welfare of elderly people.', exZh: '政府努力改善老年人的生活福利。' },

  { w: 'abstract', p: '/ˈæbstrækt/', pos: 'n. / adj.', zh: '摘要；抽象的', deck: 'academic', ex: 'Each paper begins with a short abstract and keywords.', exZh: '每篇论文开头都有一段简短的摘要和关键词。' },
  { w: 'accumulate', p: '/əˈkjuːmjəleɪt/', pos: 'v.', zh: '积累；积聚', deck: 'academic', ex: 'Over the months, small daily reviews accumulate into real knowledge.', exZh: '每天的小复习日积月累，几个月后就变成扎实的学问。' },
  { w: 'assert', p: '/əˈsɜːrt/', pos: 'v.', zh: '断言；坚称', deck: 'academic', ex: 'The author asserts that video games can teach teamwork.', exZh: '作者断言，电子游戏也能培养团队协作能力。' },
  { w: 'assumption', p: '/əˈsʌmpʃn/', pos: 'n.', zh: '假定；设想', deck: 'academic', ex: 'The plan rests on the assumption that prices stay stable.', exZh: '这个方案建立在物价保持稳定的假设之上。' },
  { w: 'cite', p: '/saɪt/', pos: 'v.', zh: '引用；引证', deck: 'academic', ex: 'Remember to cite every source you use in essays.', exZh: '写文章时，用到的每份资料都要注明出处。' },
  { w: 'clarify', p: '/ˈklærəfaɪ/', pos: 'v.', zh: '澄清；阐明', deck: 'academic', ex: 'Could you clarify what the second question means?', exZh: '你能说清楚第二道题问的是什么吗？' },
  { w: 'classify', p: '/ˈklæsɪfaɪ/', pos: 'v.', zh: '分类；归类', deck: 'academic', ex: 'Scientists classify stars by color, size and temperature.', exZh: '科学家按照颜色、大小和温度给恒星分类。' },
  { w: 'comprise', p: '/kəmˈpraɪz/', pos: 'v.', zh: '包含；由…构成', deck: 'academic', ex: 'The committee comprises teachers, parents and senior students.', exZh: '委员会由老师、家长和高年级学生组成。' },
  { w: 'contradict', p: '/ˌkɑːntrəˈdɪkt/', pos: 'v.', zh: '与…相矛盾；反驳', deck: 'academic', ex: 'His second statement directly contradicts his first one.', exZh: '他的第二次陈述和第一次直接矛盾。' },
  { w: 'criterion', p: '/kraɪˈtɪriən/', pos: 'n.', zh: '标准；准则', deck: 'academic', ex: 'Clarity is the main criterion for judging these essays.', exZh: '清楚明白是评判这些文章的首要标准。' },
  { w: 'emphasize', p: '/ˈemfəsaɪz/', pos: 'v.', zh: '强调；着重', deck: 'academic', ex: 'The coach emphasizes teamwork more than individual scores.', exZh: '教练更强调团队配合，而不是个人得分。' },
  { w: 'entail', p: '/ɪnˈteɪl/', pos: 'v.', zh: '必然涉及；需要有', deck: 'academic', ex: 'Winning the contest entails months of careful preparation.', exZh: '想在比赛中获胜，就得经过几个月的精心准备。' },
  { w: 'explicit', p: '/ɪkˈsplɪsɪt/', pos: 'adj.', zh: '明确的；清楚的', deck: 'academic', ex: 'The teacher gave explicit instructions for the group task.', exZh: '老师对小组任务给出了明确的指示。' },
  { w: 'extract', p: '/ɪkˈstrækt/', pos: 'v. / n.', zh: '提取；摘录', deck: 'academic', ex: 'Students extracted the key facts from the long article.', exZh: '学生们从这篇长文里提取出了关键事实。' },
  { w: 'illustrate', p: '/ˈɪləstreɪt/', pos: 'v.', zh: '（用例子）说明；阐明', deck: 'academic', ex: 'This chart illustrates how our study hours changed.', exZh: '这张图表清楚地展示了我们学习时间的变化。' },
  { w: 'implicit', p: '/ɪmˈplɪsɪt/', pos: 'adj.', zh: '含蓄的；不言明的', deck: 'academic', ex: 'There was an implicit rule that seniors speak first.', exZh: '有条不成文的规矩：高年级学生先发言。' },
  { w: 'indicate', p: '/ˈɪndɪkeɪt/', pos: 'v.', zh: '表明；指示', deck: 'academic', ex: 'The red light indicates that the battery is low.', exZh: '红灯亮起，表示电池电量不足。' },
  { w: 'infer', p: '/ɪnˈfɜːr/', pos: 'v.', zh: '推断；推知', deck: 'academic', ex: 'From her smile, we inferred that she passed.', exZh: '从她的笑容可以推断，她通过了。' },
  { w: 'inherent', p: '/ɪnˈhɪrənt/', pos: 'adj.', zh: '内在的；固有的', deck: 'academic', ex: 'Risk is inherent in every experiment worth trying.', exZh: '任何值得做的实验都难免有风险。' },
  { w: 'interpret', p: '/ɪnˈtɜːrprət/', pos: 'v.', zh: '解读；阐释', deck: 'academic', ex: 'How do you interpret the ending of this novel?', exZh: '你会怎样解读这部小说的结尾？' },
  { w: 'mechanism', p: '/ˈmekənɪzəm/', pos: 'n.', zh: '机制；机理', deck: 'academic', ex: 'The teacher explained the mechanism behind seasonal changes.', exZh: '老师讲解了季节变化背后的原理。' },
  { w: 'notion', p: '/ˈnoʊʃn/', pos: 'n.', zh: '概念；观念', deck: 'academic', ex: 'He rejected the notion that only talent leads to success.', exZh: '他不认同“只有天赋才能成功”这种观念。' },
  { w: 'objective', p: '/əbˈdʒektɪv/', pos: 'adj. / n.', zh: '客观的；目标', deck: 'academic', ex: 'A good report stays objective and avoids personal feelings.', exZh: '好的报告要客观，不掺杂个人情绪。' },
  { w: 'plausible', p: '/ˈplɔːzəbl/', pos: 'adj.', zh: '貌似合理的；可信的', deck: 'academic', ex: 'Her explanation sounded plausible, so nobody questioned it.', exZh: '她的解释听起来头头是道，没人提出质疑。' },
  { w: 'premise', p: '/ˈpremɪs/', pos: 'n.', zh: '前提', deck: 'academic', ex: 'The argument collapses because its basic premise is false.', exZh: '基本前提站不住脚，整个论证也就垮了。' },
  { w: 'prevalent', p: '/ˈprevələnt/', pos: 'adj.', zh: '普遍的；盛行的', deck: 'academic', ex: 'Smartphones are prevalent among students in almost every school.', exZh: '几乎每所学校的学生都在普遍使用智能手机。' },
  { w: 'profound', p: '/prəˈfaʊnd/', pos: 'adj.', zh: '深刻的；深远的', deck: 'academic', ex: 'The book had a profound effect on my thinking.', exZh: '这本书对我的思考方式产生了深远的影响。' },
  { w: 'quantify', p: '/ˈkwɑːntɪfaɪ/', pos: 'v.', zh: '量化；用数量表示', deck: 'academic', ex: 'It is hard to quantify the value of friendship.', exZh: '友谊的价值很难用数字衡量。' },
  { w: 'rationale', p: '/ˌræʃəˈnæl/', pos: 'n.', zh: '理论依据；基本原理', deck: 'academic', ex: 'The teacher explained the rationale behind the new rules.', exZh: '老师解释了新规定背后的道理。' },
  { w: 'refute', p: '/rɪˈfjuːt/', pos: 'v.', zh: '驳斥；反驳', deck: 'academic', ex: 'The data refute the claim that grades depend on luck.', exZh: '数据驳倒了“成绩靠运气”的说法。' },
  { w: 'rigorous', p: '/ˈrɪɡərəs/', pos: 'adj.', zh: '严谨的；严格的', deck: 'academic', ex: 'The experiment followed a rigorous set of safety steps.', exZh: '这项实验遵循了一套严格的安全操作步骤。' },
  { w: 'significance', p: '/sɪɡˈnɪfɪkəns/', pos: 'n.', zh: '意义；重要性', deck: 'academic', ex: 'Nobody understood the significance of that small detail then.', exZh: '当时没有人意识到那个小细节的重要意义。' },
  { w: 'specify', p: '/ˈspesɪfaɪ/', pos: 'v.', zh: '具体说明；明确规定', deck: 'academic', ex: 'The form asks you to specify your preferred contact time.', exZh: '表格要求写明你方便联系的时间。' },
  { w: 'subsequent', p: '/ˈsʌbsɪkwənt/', pos: 'adj.', zh: '随后的；接着的', deck: 'academic', ex: 'Heavy rain and subsequent floods delayed the sports meet.', exZh: '大雨和随之而来的洪水让运动会延期了。' },
  { w: 'survey', p: '/ˈsɜːrveɪ/', pos: 'n. / v.', zh: '调查；民意调查', deck: 'academic', ex: 'We surveyed two hundred students about their sleep habits.', exZh: '我们就睡眠习惯调查了两百名学生。' },
  { w: 'tentative', p: '/ˈtentətɪv/', pos: 'adj.', zh: '试探性的；暂定的', deck: 'academic', ex: 'We made a tentative plan to meet on Thursday.', exZh: '我们初步商量好周四碰面。' },
  { w: 'theoretical', p: '/ˌθiːəˈretɪkl/', pos: 'adj.', zh: '理论的', deck: 'academic', ex: 'The course pairs theoretical physics with hands-on lab work.', exZh: '这门课把理论物理和动手实验结合在一起。' },
  { w: 'transition', p: '/trænˈzɪʃn/', pos: 'n.', zh: '过渡；转变', deck: 'academic', ex: 'Good essays need a smooth transition between paragraphs.', exZh: '好文章需要段落之间过渡自然。' },
  { w: 'underlying', p: '/ˌʌndərˈlaɪɪŋ/', pos: 'adj.', zh: '潜在的；根本的', deck: 'academic', ex: 'Stress is the underlying cause of many sleep problems.', exZh: '压力是许多睡眠问题的深层原因。' },
  { w: 'verify', p: '/ˈverɪfaɪ/', pos: 'v.', zh: '核实；查证', deck: 'academic', ex: 'Always verify your sources before quoting them in class.', exZh: '在课堂上引用之前，一定要先核实资料来源。' },

  { w: 'abyss', p: '/əˈbɪs/', pos: 'n.', zh: '深渊', deck: 'classic', ex: 'The old map marked an abyss no explorer had crossed.', exZh: '古地图上标着一道无人跨过的深渊。' },
  { w: 'anguish', p: '/ˈæŋɡwɪʃ/', pos: 'n.', zh: '极度痛苦；悲恸', deck: 'classic', ex: 'She read the letter with growing anguish in her heart.', exZh: '读着那封信，她心中的悲痛越来越深。' },
  { w: 'banish', p: '/ˈbænɪʃ/', pos: 'v.', zh: '放逐；驱逐', deck: 'classic', ex: 'The king banished the knight from the kingdom forever.', exZh: '国王把骑士永远逐出了王国。' },
  { w: 'beacon', p: '/ˈbiːkən/', pos: 'n.', zh: '灯塔；信标', deck: 'classic', ex: 'A single beacon guided the lost ships safely home.', exZh: '一座孤独的灯塔为迷航的船只指引平安回家的路。' },
  { w: 'betray', p: '/bɪˈtreɪ/', pos: 'v.', zh: '背叛；出卖', deck: 'classic', ex: 'He would rather die than betray his closest friend.', exZh: '他宁死也不肯背叛自己最要好的朋友。' },
  { w: 'bleak', p: '/bliːk/', pos: 'adj.', zh: '荒凉的；阴郁的', deck: 'classic', ex: 'The moor looked bleak and gray under the winter sky.', exZh: '冬日的天空下，这片荒原显得荒凉而灰暗。' },
  { w: 'bliss', p: '/blɪs/', pos: 'n.', zh: '极乐；巨大的幸福', deck: 'classic', ex: 'Lying in the warm sun, she felt pure bliss.', exZh: '沐浴着温暖的阳光，她感到无比幸福。' },
  { w: 'brook', p: '/brʊk/', pos: 'n.', zh: '小溪', deck: 'classic', ex: 'Children followed the brook up the green valley.', exZh: '孩子们沿着小溪往绿色的山谷里走去。' },
  { w: 'cease', p: '/siːs/', pos: 'v.', zh: '停止；终止', deck: 'classic', ex: 'The rain ceased at last, and stars appeared above.', exZh: '雨终于停了，头顶上现出点点星光。' },
  { w: 'cherish', p: '/ˈtʃerɪʃ/', pos: 'v.', zh: '珍爱；珍藏', deck: 'classic', ex: 'She cherished the old photographs from her hometown.', exZh: '她一直珍藏着从家乡带来的老照片。' },
  { w: 'cloak', p: '/kloʊk/', pos: 'n. / v.', zh: '斗篷；遮掩', deck: 'classic', ex: 'He pulled his dark cloak tighter against the cold wind.', exZh: '他裹紧深色斗篷，抵挡刺骨的寒风。' },
  { w: 'curse', p: '/kɜːrs/', pos: 'n. / v.', zh: '诅咒；咒骂', deck: 'classic', ex: 'Legend says a curse sleeps inside the ancient castle.', exZh: '传说古堡里沉睡着一个诅咒。' },
  { w: 'dismay', p: '/dɪsˈmeɪ/', pos: 'n.', zh: '惊愕；沮丧', deck: 'classic', ex: 'To her dismay, the train had already left the station.', exZh: '令她沮丧的是，火车已经离站了。' },
  { w: 'doom', p: '/duːm/', pos: 'n. / v.', zh: '厄运；注定', deck: 'classic', ex: 'The old prophecy seemed to doom the young prince.', exZh: '古老的预言似乎注定了年轻王子的厄运。' },
  { w: 'dread', p: '/dred/', pos: 'n. / v.', zh: '恐惧；畏惧', deck: 'classic', ex: 'He felt a quiet dread as the door creaked open.', exZh: '门吱呀一声开了，他心里涌起一阵无名的恐惧。' },
  { w: 'dwell', p: '/dwel/', pos: 'v.', zh: '居住；栖身', deck: 'classic', ex: 'An old fisherman dwelt alone by the rocky shore.', exZh: '一位老渔夫独自住在多礁的海岸边。' },
  { w: 'eerie', p: '/ˈɪri/', pos: 'adj.', zh: '阴森可怖的；怪异的', deck: 'classic', ex: 'An eerie silence filled the empty hall at midnight.', exZh: '午夜空荡荡的大厅里，弥漫着阴森的寂静。' },
  { w: 'eloquent', p: '/ˈeləkwənt/', pos: 'adj.', zh: '雄辩的；动人的', deck: 'classic', ex: 'Her eloquent speech moved the whole audience to tears.', exZh: '她的演讲雄辩动人，全场听众都落了泪。' },
  { w: 'enchant', p: '/ɪnˈtʃænt/', pos: 'v.', zh: '使着迷；使陶醉', deck: 'classic', ex: "The garden's roses enchanted every visitor that spring.", exZh: '那年春天，园中的玫瑰让每位来客都心醉神迷。' },
  { w: 'exile', p: '/ˈeksaɪl/', pos: 'n. / v.', zh: '流放；流亡者', deck: 'classic', ex: 'The poet spent long years in lonely exile overseas.', exZh: '诗人在海外度过了多年孤寂的流亡生活。' },
  { w: 'falter', p: '/ˈfɔːltər/', pos: 'v.', zh: '动摇；蹒跚', deck: 'classic', ex: 'Her voice faltered when she spoke about home.', exZh: '谈起家乡时，她的声音微微发颤。' },
  { w: 'feast', p: '/fiːst/', pos: 'n.', zh: '盛宴；宴会', deck: 'classic', ex: 'The village prepared a great feast for the harvest.', exZh: '丰收时节，村里摆起了盛大的宴席。' },
  { w: 'feeble', p: '/ˈfiːbl/', pos: 'adj.', zh: '虚弱无力的', deck: 'classic', ex: 'The old dog gave a feeble wag of its tail.', exZh: '老狗有气无力地摇了摇尾巴。' },
  { w: 'forsake', p: '/fərˈseɪk/', pos: 'v.', zh: '抛弃；离弃', deck: 'classic', ex: 'He promised never to forsake the friends of his youth.', exZh: '他许诺永远不离弃年少时的朋友。' },
  { w: 'fortress', p: '/ˈfɔːrtrəs/', pos: 'n.', zh: '堡垒；要塞', deck: 'classic', ex: 'Stone walls made the mountain fortress almost impossible to attack.', exZh: '石墙让这座山中要塞几乎无法攻破。' },
  { w: 'fury', p: '/ˈfjʊri/', pos: 'n.', zh: '狂怒；暴怒', deck: 'classic', ex: 'He slammed the book shut in a sudden fury.', exZh: '他怒火乍起，砰地一声合上了书。' },
  { w: 'gaze', p: '/ɡeɪz/', pos: 'v. / n.', zh: '凝视；注视', deck: 'classic', ex: 'She gazed across the quiet lake until dusk fell.', exZh: '她凝望着平静的湖面，直到暮色四合。' },
  { w: 'grim', p: '/ɡrɪm/', pos: 'adj.', zh: '冷酷的；严峻的', deck: 'classic', ex: 'The captain wore a grim look as the storm neared.', exZh: '风暴渐渐逼近，船长神色严峻。' },
  { w: 'hearth', p: '/hɑːrθ/', pos: 'n.', zh: '壁炉；炉边', deck: 'classic', ex: 'The whole family gathered around the warm hearth.', exZh: '一家人围坐在暖烘烘的壁炉旁。' },
  { w: 'immortal', p: '/ɪˈmɔːrtl/', pos: 'adj.', zh: '不朽的；永世的', deck: 'classic', ex: 'Great stories make their heroes immortal in our memory.', exZh: '伟大的故事让书中的英雄在人们记忆里永存。' },
  { w: 'lament', p: '/ləˈment/', pos: 'v. / n.', zh: '哀叹；悲叹', deck: 'classic', ex: 'The old woman lamented the loss of her village.', exZh: '老妇人哀叹失去了自己的村庄。' },
  { w: 'marvel', p: '/ˈmɑːrvl/', pos: 'n. / v.', zh: '奇迹；惊叹', deck: 'classic', ex: 'Visitors marveled at the golden ceiling of the palace.', exZh: '宫殿金色的穹顶令游客们赞叹不已。' },
  { w: 'quest', p: '/kwest/', pos: 'n.', zh: '探寻；追求', deck: 'classic', ex: 'The young knight set out on a quest for truth.', exZh: '年轻的骑士踏上了追寻真相的旅途。' },
  { w: 'tender', p: '/ˈtendər/', pos: 'adj.', zh: '温柔的；柔嫩的', deck: 'classic', ex: 'She gave the tired traveler a tender smile.', exZh: '她对着疲惫的旅人温柔地笑了笑。' },
  { w: 'triumph', p: '/ˈtraɪʌmf/', pos: 'n. / v.', zh: '胜利；凯旋', deck: 'classic', ex: 'The return home felt like a triumph over fear.', exZh: '这次归来，就像一次战胜恐惧的凯旋。' },
  { w: 'twilight', p: '/ˈtwaɪlaɪt/', pos: 'n.', zh: '黄昏；暮光', deck: 'classic', ex: 'Fireflies rose from the grass in the soft twilight.', exZh: '柔和的暮色里，萤火虫从草丛中飞起。' },
  { w: 'wander', p: '/ˈwɑːndər/', pos: 'v.', zh: '漫游；徘徊', deck: 'classic', ex: 'They wandered through the old town without any map.', exZh: '他们不带地图，在老城里随意闲逛。' },
  { w: 'weep', p: '/wiːp/', pos: 'v.', zh: '哭泣；流泪', deck: 'classic', ex: 'She wept quietly when the ship left the harbor.', exZh: '轮船驶离港口时，她在一旁悄悄落泪。' },
  { w: 'wither', p: '/ˈwɪðər/', pos: 'v.', zh: '枯萎；凋零', deck: 'classic', ex: 'The summer roses withered long before autumn came.', exZh: '夏日的玫瑰早在秋天来临之前就凋零了。' },

  { w: 'weather', p: '/ˈweðər/', pos: 'n.', zh: '天气；气象', deck: 'junior', ex: 'The weather changed suddenly, so we stayed inside.', exZh: '天气突然变了，所以我们待在家里。' },
  { w: 'season', p: '/ˈsiːzn/', pos: 'n.', zh: '季节；雨季', deck: 'junior', ex: 'Autumn is my favorite season because the leaves turn gold.', exZh: '秋天是我最喜欢的季节，因为树叶会变成金色。' },
  { w: 'climate', p: '/ˈklaɪmət/', pos: 'n.', zh: '气候', deck: 'junior', ex: 'The climate here is mild, so people enjoy outdoor sports.', exZh: '这里的气候温和，所以人们喜欢户外运动。' },
  { w: 'thunder', p: '/ˈθʌndər/', pos: 'n.', zh: '雷；雷声', deck: 'junior', ex: 'Thunder rolled across the sky just before the heavy rain.', exZh: '大雨来临之前，雷声在天空中滚过。' },
  { w: 'fog', p: '/fɒɡ/', pos: 'n.', zh: '雾；雾气', deck: 'junior', ex: 'Heavy fog made driving dangerous, so the bus arrived late.', exZh: '浓雾使行车变得危险，所以公交车到晚了。' },
  { w: 'flood', p: '/flʌd/', pos: 'n. / v.', zh: '洪水；水灾；淹没', deck: 'junior', ex: 'The flood carried away bridges, and many families lost homes.', exZh: '洪水冲走了桥梁，许多家庭失去了家园。' },
  { w: 'drought', p: '/draʊt/', pos: 'n.', zh: '旱灾；长期干旱', deck: 'junior', ex: 'Years of drought turned green fields into dry, cracked ground.', exZh: '连年旱灾把绿色的田野变成了干裂的土地。' },
  { w: 'earthquake', p: '/ˈɜːrθkweɪk/', pos: 'n.', zh: '地震', deck: 'junior', ex: 'During the earthquake we hid under a strong desk and waited.', exZh: '地震发生时，我们躲在结实的桌子下面等待。' },
  { w: 'typhoon', p: '/taɪˈfuːn/', pos: 'n.', zh: '台风', deck: 'junior', ex: 'The typhoon will arrive tonight, so stay at home and keep warm.', exZh: '台风今晚就要来了，所以待在家里注意保暖。' },
  { w: 'pollution', p: '/pəˈluːʃn/', pos: 'n.', zh: '污染；污染物', deck: 'junior', ex: 'Burning coal adds pollution to the air we breathe every day.', exZh: '烧煤会加剧我们每天呼吸的空气的污染。' },
  { w: 'garbage', p: '/ˈɡɑːrbɪdʒ/', pos: 'n.', zh: '垃圾；废物', deck: 'junior', ex: 'We sort garbage daily so that less of it goes to landfills.', exZh: '我们每天给垃圾分类，以便更少的垃圾进入填埋场。' },
  { w: 'plastic', p: '/ˈplæstɪk/', pos: 'n. / adj.', zh: '塑料；塑料制品；塑料制的', deck: 'junior', ex: 'Fewer shops hand out plastic bags now, and customers bring their own.', exZh: '现在更少的商店发放塑料袋，顾客们自己带袋子。' },
  { w: 'energy', p: '/ˈenərdʒi/', pos: 'n.', zh: '能源；能量；精力', deck: 'junior', ex: 'Riding to school saves energy and gives me exercise too.', exZh: '骑车上学既能节约能源，也能锻炼身体。' },
  { w: 'forest', p: '/ˈfɔːrɪst/', pos: 'n.', zh: '森林；林区', deck: 'junior', ex: 'Tall trees in the forest provide shade for birds and small animals.', exZh: '森林里高大的树木为鸟类和小动物提供阴凉。' },
  { w: 'wildlife', p: '/ˈwaɪldlaɪf/', pos: 'n.', zh: '野生动物；野生生物', deck: 'junior', ex: 'Protecting wildlife matters, because every animal keeps nature in balance.', exZh: '保护野生动物很重要，因为每种动物都让自然保持平衡。' },
  { w: 'countryside', p: '/ˈkʌntrisaɪd/', pos: 'n.', zh: '乡村；农村', deck: 'junior', ex: 'Life in the countryside is quiet, and the air tastes much fresher.', exZh: '乡村的生活很安静，空气也清新得多。' },
  { w: 'desert', p: '/ˈdezərt/', pos: 'n.', zh: '沙漠；荒地', deck: 'junior', ex: 'Few plants survive in the desert, but some store water in stems.', exZh: '很少有植物能在沙漠中存活，但有些会把水储存在茎里。' },
  { w: 'reuse', p: '/ˌriːˈjuːz/', pos: 'v. / n.', zh: '再次使用；重复利用', deck: 'junior', ex: 'We reuse glass bottles to hold beans, rice and homemade jam.', exZh: '我们重复使用玻璃瓶来装豆子、大米和自制果酱。' },
  { w: 'station', p: '/ˈsteɪʃn/', pos: 'n.', zh: '车站；站；局', deck: 'junior', ex: 'My uncle met us at the train station with a big smile.', exZh: '我叔叔带着灿烂的笑容在火车站迎接我们。' },
  { w: 'platform', p: '/ˈplætfɔːrm/', pos: 'n.', zh: '站台；平台；讲台', deck: 'junior', ex: 'Please wait on Platform Two, for the train is running late today.', exZh: '请在二号站台等候，因为今天的火车晚点了。' },
  { w: 'ticket', p: '/ˈtɪkɪt/', pos: 'n.', zh: '票；入场券；罚单', deck: 'junior', ex: 'We booked our tickets online the week before the holiday.', exZh: '我们在假期前一周就在网上订好了票。' },
  { w: 'passenger', p: '/ˈpæsɪndʒər/', pos: 'n.', zh: '乘客；旅客', deck: 'junior', ex: 'Every passenger on the bus wore a seat belt during the trip.', exZh: '行程中公交车上的每位乘客都系了安全带。' },
  { w: 'flight', p: '/flaɪt/', pos: 'n.', zh: '航班；飞行', deck: 'junior', ex: 'Our flight was two hours late, so we missed the evening show.', exZh: '我们的航班晚点了两个小时，所以错过了晚上的演出。' },
  { w: 'airport', p: '/ˈerpɔːrt/', pos: 'n.', zh: '机场', deck: 'junior', ex: 'The airport is far from home, so we left before sunrise.', exZh: '机场离家很远，所以我们在日出前就出发了。' },
  { w: 'highway', p: '/ˈhaɪweɪ/', pos: 'n.', zh: '公路；干线', deck: 'junior', ex: 'A new highway connects our town with the capital in one hour.', exZh: '一条新公路把我们的城镇和首都连起来，只需一个小时。' },
  { w: 'direction', p: '/dəˈrekʃn/', pos: 'n.', zh: '方向；指导', deck: 'junior', ex: 'Follow this road in the direction of the river, then turn left.', exZh: '沿着这条路朝河的方向走，然后左转。' },
  { w: 'opposite', p: '/ˈɑːpəzɪt/', pos: 'adj. / prep.', zh: '相反的；对面的；在……对面', deck: 'junior', ex: 'The bank stands opposite the bookshop, so going there is quite easy.', exZh: '银行就在书店对面，所以去那里很方便。' },
  { w: 'straight', p: '/streɪt/', pos: 'adv. / adj.', zh: '直接地；笔直地；直的', deck: 'junior', ex: 'Go straight ahead for three blocks and you will see the gate.', exZh: '一直往前走过三个街区，你就会看到大门。' },
  { w: 'crowded', p: '/ˈkraʊdɪd/', pos: 'adj.', zh: '拥挤的；人满为患的', deck: 'junior', ex: 'The underground train gets crowded, especially during the morning rush.', exZh: '地铁会变得很拥挤，尤其是在早高峰时段。' },
  { w: 'delay', p: '/dɪˈleɪ/', pos: 'v. / n.', zh: '推迟；延误；耽搁', deck: 'junior', ex: 'Heavy snow delayed our bus, but the guide still waited for us.', exZh: '大雪延误了我们的班车，但导游仍然在等我们。' },
  { w: 'cancel', p: '/ˈkænsl/', pos: 'v.', zh: '取消；撤销', deck: 'junior', ex: 'They had to cancel the open-air concert because the storm was coming.', exZh: '因为暴风雨即将来临，他们不得不取消露天音乐会。' },
  { w: 'transfer', p: '/trænsˈfɜːr/', pos: 'v. / n.', zh: '换乘；转移；调动', deck: 'junior', ex: 'Transfer to Line Four at the next station for the science museum.', exZh: '在下一站换乘四号线可以到达科学博物馆。' },
  { w: 'route', p: '/ruːt/', pos: 'n.', zh: '路线；途径', deck: 'junior', ex: 'Cycling to school along the river is my favorite route.', exZh: '沿河边骑车上学是我最喜欢的路线。' },
  { w: 'museum', p: '/mjuˈziːəm/', pos: 'n.', zh: '博物馆', deck: 'junior', ex: 'The museum opens free on Tuesdays, and old tools amaze every visitor.', exZh: '这家博物馆周二免费开放，古老的工具让每位参观者惊叹。' },
  { w: 'downtown', p: '/ˌdaʊnˈtaʊn/', pos: 'adv. / adj.', zh: '往市中心；在市中心的', deck: 'junior', ex: 'We took a taxi downtown to watch the New Year fireworks.', exZh: '我们坐出租车去市中心看新年烟火。' },
  { w: 'screen', p: '/skriːn/', pos: 'n.', zh: '屏幕；银幕；屏障', deck: 'junior', ex: 'Staring at a screen for hours makes my eyes dry and tired.', exZh: '盯着屏幕几个小时会让我的眼睛又干又累。' },
  { w: 'keyboard', p: '/ˈkiːbɔːrd/', pos: 'n.', zh: '键盘', deck: 'junior', ex: 'He types on the keyboard so fast that I cannot follow him.', exZh: '他在键盘上打字快得我跟不上他。' },
  { w: 'download', p: '/ˌdaʊnˈloʊd/', pos: 'v. / n.', zh: '下载；下载的文件', deck: 'junior', ex: 'You can download the listening practice from our class website tonight.', exZh: '你今晚可以从我们班的网站上下载听力练习。' },
  { w: 'password', p: '/ˈpæswɜːrd/', pos: 'n.', zh: '密码；口令', deck: 'junior', ex: 'Never give your password to strangers who ask for it online.', exZh: '绝不要把密码告诉网上向你要密码的陌生人。' },
  { w: 'battery', p: '/ˈbætri/', pos: 'n.', zh: '电池；电瓶', deck: 'junior', ex: 'My phone battery dies quickly, so I carry a small one everywhere.', exZh: '我的手机电池耗电很快，所以我随身带一个小的。' },
  { w: 'internet', p: '/ˈɪntərnet/', pos: 'n.', zh: '互联网；因特网', deck: 'junior', ex: 'The internet brings the world closer and helps us learn new things.', exZh: '互联网让世界更近，也帮助我们学习新事物。' },
  { w: 'website', p: '/ˈwebsaɪt/', pos: 'n.', zh: '网站', deck: 'junior', ex: 'Our school website shows photos, notices and book lists for every grade.', exZh: '我们学校的网站上展示着照片、通知和各年级的书单。' },
  { w: 'online', p: '/ˌɑːnˈlaɪn/', pos: 'adj. / adv.', zh: '在线的；网上的；在网上', deck: 'junior', ex: 'More people watch concerts online now, yet live shows still feel special.', exZh: '现在更多人在网上看演唱会，但现场演出依然很特别。' },
  { w: 'device', p: '/dɪˈvaɪs/', pos: 'n.', zh: '设备；装置；仪器', deck: 'junior', ex: 'Each student brings a device to class and follows clear usage rules.', exZh: '每位学生带一台设备上课，并遵守明确的使用规则。' },
  { w: 'digital', p: '/ˈdɪdʒɪtl/', pos: 'adj.', zh: '数字的；数码的', deck: 'junior', ex: 'A digital dictionary opens faster than the heavy paper one on my desk.', exZh: '电子词典比我桌上那本厚厚的纸质词典打开得更快。' },
  { w: 'information', p: '/ˌɪnfərˈmeɪʃn/', pos: 'n.', zh: '信息；消息；资料', deck: 'junior', ex: 'Please send me the information about the train times as soon as possible.', exZh: '请尽快把火车时刻的信息发给我。' },
  { w: 'media', p: '/ˈmiːdiə/', pos: 'n.', zh: '媒体；传播媒介', deck: 'junior', ex: 'Through social media, a kind act can travel across the country in hours.', exZh: '通过社交媒体，一个善举能在几小时内传遍全国。' },
  { w: 'magazine', p: '/ˈmæɡəziːn/', pos: 'n.', zh: '杂志；期刊', deck: 'junior', ex: 'I read an English magazine every week to build a larger vocabulary.', exZh: '我每周读一本英文杂志来扩大词汇量。' },
  { w: 'connect', p: '/kəˈnekt/', pos: 'v.', zh: '连接；联系；沟通', deck: 'junior', ex: 'High-speed rail connects distant cities, making weekend trips easy for families.', exZh: '高铁把遥远的城市连接起来，让家庭周末出行变得轻松。' },
  { w: 'festival', p: '/ˈfestɪvl/', pos: 'n.', zh: '节日；节会', deck: 'junior', ex: 'During the Spring Festival, families gather to make dumplings and share stories.', exZh: '春节期间，家人们聚在一起包饺子、讲故事。' },
  { w: 'custom', p: '/ˈkʌstəm/', pos: 'n.', zh: '风俗；习俗；惯例', deck: 'junior', ex: 'It is a local custom to greet guests with a cup of warm tea.', exZh: '用一杯热茶迎接客人是当地的一种习俗。' },
  { w: 'tradition', p: '/trəˈdɪʃn/', pos: 'n.', zh: '传统；惯例', deck: 'junior', ex: 'Every year our village keeps the tradition of lantern making by hand.', exZh: '每年我们村都保持着手工做灯笼的传统。' },
  { w: 'costume', p: '/ˈkɑːstuːm/', pos: 'n.', zh: '服装；戏装；演出服', deck: 'junior', ex: 'She wore a paper dragon costume and danced down the whole street.', exZh: '她穿着一身纸做的龙形戏服，沿着整条街跳舞。' },
  { w: 'lantern', p: '/ˈlæntərn/', pos: 'n.', zh: '灯笼；提灯', deck: 'junior', ex: 'Red lanterns hung above the gate, lighting the way for late walkers.', exZh: '红灯笼挂在门上方，为晚归的行人照亮了路。' },
  { w: 'gift', p: '/ɡɪft/', pos: 'n.', zh: '礼物；天赋', deck: 'junior', ex: 'A handmade gift means more than an expensive one from a shop.', exZh: '一份手工做的礼物比商店里昂贵的礼物更有意义。' },
  { w: 'souvenir', p: '/ˌsuːvəˈnɪr/', pos: 'n.', zh: '纪念品', deck: 'junior', ex: 'He bought a small souvenir for each cousin after visiting the museum.', exZh: '参观完博物馆后，他给每个表亲买了一件小纪念品。' },
  { w: 'decorate', p: '/ˈdekəreɪt/', pos: 'v.', zh: '装饰；布置', deck: 'junior', ex: 'We decorated the classroom with paper flowers before the New Year party.', exZh: '元旦联欢会前，我们用纸花布置了教室。' },
  { w: 'tourist', p: '/ˈtʊrɪst/', pos: 'n.', zh: '游客；观光者', deck: 'junior', ex: 'Each tourist received a free map at the entrance of the old town.', exZh: '每位游客在老城入口处都能免费领取一张地图。' },
  { w: 'guide', p: '/ɡaɪd/', pos: 'n. / v.', zh: '导游；指南；引导；带领', deck: 'junior', ex: 'Our guide showed the group an ancient bridge over the clear stream.', exZh: '我们的导游给团队介绍了一座横跨清澈溪流的老桥。' },
  { w: 'luggage', p: '/ˈlʌɡɪdʒ/', pos: 'n.', zh: '行李；行李箱', deck: 'junior', ex: 'Put your luggage under the seat and keep the aisle clear.', exZh: '把行李放在座位下面，让通道保持通畅。' },
  { w: 'passport', p: '/ˈpæspɔːrt/', pos: 'n.', zh: '护照', deck: 'junior', ex: 'You need a passport to travel abroad, and it must stay valid.', exZh: '出国旅行你需要护照，而且护照必须在有效期内。' },
  { w: 'abroad', p: '/əˈbrɔːd/', pos: 'adv.', zh: '在国外；到国外', deck: 'junior', ex: 'My sister hopes to study abroad and then bring her skills home.', exZh: '我姐姐希望到国外学习，然后带着所学回到祖国。' },
  { w: 'scenery', p: '/ˈsiːnəri/', pos: 'n.', zh: '风景；景色', deck: 'junior', ex: 'The scenery along the mountain road surprised us with its quiet beauty.', exZh: '山路沿途的风景以其宁静的美让我们惊叹。' },
  { w: 'island', p: '/ˈaɪlənd/', pos: 'n.', zh: '岛；岛屿', deck: 'junior', ex: 'We took a ferry to a small island and swam in the clear sea.', exZh: '我们坐渡轮去了一个小岛，在清澈的海水里游泳。' },
  { w: 'temple', p: '/ˈtempl/', pos: 'n.', zh: '庙宇；寺院', deck: 'junior', ex: 'The old temple on the hill has welcomed visitors for five hundred years.', exZh: '山上那座古老的寺庙五百年来一直迎接着来访的人。' },
  { w: 'health', p: '/helθ/', pos: 'n.', zh: '健康；健康状况', deck: 'junior', ex: 'Good health depends on fresh air, sound sleep and a light diet.', exZh: '良好的健康取决于新鲜空气、充足睡眠和清淡饮食。' },
  { w: 'ambulance', p: '/ˈæmbjələns/', pos: 'n.', zh: '救护车', deck: 'junior', ex: 'An ambulance arrived within minutes and carried the hurt player away.', exZh: '几分钟内救护车就到了，把受伤的队员抬走了。' },
  { w: 'disease', p: '/dɪˈziːz/', pos: 'n.', zh: '疾病；病', deck: 'junior', ex: 'Washing hands often is the cheapest way to prevent many diseases.', exZh: '勤洗手是预防许多疾病最省钱的方法。' },
  { w: 'virus', p: '/ˈvaɪrəs/', pos: 'n.', zh: '病毒', deck: 'junior', ex: 'A common virus can make you cough and feel weak for days.', exZh: '一种普通病毒会让你咳嗽，并且好几天感到虚弱。' },
  { w: 'exercise', p: '/ˈeksərsaɪz/', pos: 'n. / v.', zh: '锻炼；练习；锻炼活动', deck: 'junior', ex: 'Thirty minutes of exercise a day keeps your body strong and alert.', exZh: '每天三十分钟的锻炼能让你的身体强壮又清醒。' },
  { w: 'injection', p: '/ɪnˈdʒekʃn/', pos: 'n.', zh: '打针；注射', deck: 'junior', ex: 'He feared the injection, but it hurt far less than he expected.', exZh: '他害怕打针，但疼痛远比他预想的轻。' },
  { w: 'temperature', p: '/ˈtemprətʃər/', pos: 'n.', zh: '温度；体温；发烧', deck: 'junior', ex: 'The nurse took my temperature and said the fever was going down.', exZh: '护士量了我的体温，说烧正在退。' },
  { w: 'sick', p: '/sɪk/', pos: 'adj.', zh: '生病的；恶心的', deck: 'junior', ex: 'He felt sick on the long bus ride and rested at home all day.', exZh: '长途坐车让他恶心，他在家休息了一整天。' },
  { w: 'dentist', p: '/ˈdentɪst/', pos: 'n.', zh: '牙医', deck: 'junior', ex: 'Seeing a dentist every half year keeps your teeth strong and clean.', exZh: '每半年看一次牙医能让你的牙齿坚固又干净。' },
  { w: 'nurse', p: '/nɜːrs/', pos: 'n.', zh: '护士', deck: 'junior', ex: 'The kind nurse helped the old man cross the busy street safely.', exZh: '那位好心的护士帮助老人安全地过了繁忙的马路。' },
  { w: 'recover', p: '/rɪˈkʌvər/', pos: 'v.', zh: '恢复；康复', deck: 'junior', ex: 'It took him two weeks to recover from the long illness.', exZh: '他花了两周时间才从久病中康复。' },
  { w: 'rest', p: '/rest/', pos: 'n. / v.', zh: '休息；剩余部分', deck: 'junior', ex: 'Have a short rest every hour, or your eyes will ache.', exZh: '每一小时稍作休息，否则你的眼睛会疼。' },
  { w: 'gym', p: '/dʒɪm/', pos: 'n.', zh: '健身房；体育馆', deck: 'junior', ex: 'Our school gym stays open to everyone until nine in the evening.', exZh: '我们学校的体育馆每天晚上九点前都向大家开放。' },
  { w: 'breath', p: '/breθ/', pos: 'n.', zh: '呼吸；一口气', deck: 'junior', ex: 'Take a deep breath before you stand up to give a speech.', exZh: '站起来演讲之前先深吸一口气。' },
  { w: 'jog', p: '/dʒɑːɡ/', pos: 'v. / n.', zh: '慢跑', deck: 'junior', ex: 'My father jogs along the river every morning, rain or shine.', exZh: '我爸爸每天早上都沿河慢跑，从不间断。' },

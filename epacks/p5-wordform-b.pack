  { id: 'wf106', base: 'benefit', pos: 'v.', zh: '有益于', n: 'benefit', v: 'benefit', adj: 'beneficial', adv: 'beneficially', exam: '高考', tip: 'benefit 名动同形，可直接作名词表好处；be 动词后或修饰名词填形容词 beneficial，be beneficial to 是高频搭配；修饰动词用 beneficially。' },
  { id: 'wf107', base: 'calculate', pos: 'v.', zh: '计算', n: 'calculation', v: 'calculate', adj: '', adv: '', exam: '高考', tip: '冠词或介词后填名词 calculation，复数加 s；作谓语用 calculate，注意时态与语态。' },
